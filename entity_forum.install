/**
 * Add the author_name snapshot column and make author_uid signed.
 *
 * author_uid becomes signed so a deleted member's posts can keep their
 * "last uid" flipped to negative (-uid), making former-member posts
 * trivially queryable (author_uid < 0) and reinstatable via abs(uid).
 */
function entity_forum_update_1000() {
  $name_spec = array(
    'type' => 'varchar',
    'length' => 60,
    'not null' => TRUE,
    'default' => '',
    'description' => 'Snapshot of the author display name at save time; shown when the account no longer exists.',
  );
  $uid_spec = array(
    'type' => 'int',
    'not null' => TRUE,
    'default' => 0,
    'description' => 'The {users}.uid of the author. Flipped to negative ("last uid") when the account is deleted.',
  );
  foreach (array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply') as $table) {
    if (!db_field_exists($table, 'author_name')) {
      db_add_field($table, 'author_name', $name_spec);
    }
    db_change_field($table, 'author_uid', 'author_uid', $uid_spec);
  }
}

/**
 * Adds voice_count and attachment_count to {entity_forum_topic} and
 * populates them for existing topics.
 */
function entity_forum_update_1001(&$sandbox) {
  if (!isset($sandbox['progress'])) {
    if (!db_field_exists('entity_forum_topic', 'voice_count')) {
      db_add_field('entity_forum_topic', 'voice_count', array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'default' => 1,
        'description' => 'Denormalized count of distinct participants (topic author plus published repliers) — the bbPress "Voices".',
      ));
    }
    if (!db_field_exists('entity_forum_topic', 'attachment_count')) {
      db_add_field('entity_forum_topic', 'attachment_count', array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'default' => 0,
        'description' => 'Denormalized count of {file_usage} attachments on the topic and its published replies.',
      ));
    }
    // Rebuild the schema cache so the stats recalculation (and any entity
    // save via backdrop_write_record) sees the new columns immediately.
    backdrop_get_complete_schema(TRUE);
    $sandbox['progress'] = 0;
    $sandbox['max'] = (int) db_query('SELECT COUNT(topic_id) FROM {entity_forum_topic}')->fetchField();
  }

  $topic_ids = db_query_range('SELECT topic_id FROM {entity_forum_topic} ORDER BY topic_id', $sandbox['progress'], 100)->fetchCol();
  foreach ($topic_ids as $topic_id) {
    entity_forum_topic_recalculate_stats($topic_id);
    $sandbox['progress']++;
  }

  $sandbox['#finished'] = $sandbox['max'] ? min(1, $sandbox['progress'] / $sandbox['max']) : 1;
  if ($sandbox['#finished'] >= 1) {
    return t('Added voice and attachment counts; recalculated stats for @count topics.', array('@count' => $sandbox['progress']));
  }
}

/**
 * Moves private-forum attachment files into the private:// scheme.
 *
 * Secures existing imported attachments: any file whose forum is private
 * is moved from public:// to private:// so entity_forum_file_download()
 * can gate it. Public-forum files are left in public://. Requires the
 * private file system path to be configured first.
 */
function entity_forum_update_1002(&$sandbox) {
  if (!file_stream_wrapper_valid_scheme('private')) {
    throw new UpdateException('The private file system path is not configured. Set it at admin/config/media/file-system, then run updates again.');
  }

  if (!isset($sandbox['progress'])) {
    $sandbox['fids'] = db_query("SELECT DISTINCT fid FROM {file_usage} WHERE module = 'entity_forum' ORDER BY fid")->fetchCol();
    $sandbox['progress'] = 0;
    $sandbox['moved'] = 0;
    $sandbox['max'] = count($sandbox['fids']);
  }

  $slice = array_slice($sandbox['fids'], $sandbox['progress'], 50);
  foreach ($slice as $fid) {
    $file = file_load($fid);
    if ($file && entity_forum_rescheme_file($file)) {
      $sandbox['moved']++;
    }
    $sandbox['progress']++;
  }

  $sandbox['#finished'] = $sandbox['max'] ? min(1, $sandbox['progress'] / $sandbox['max']) : 1;
  if ($sandbox['#finished'] >= 1) {
    return t('Secured attachments: moved @moved private-forum file(s) to private://, checked @total.', array(
      '@moved' => $sandbox['moved'],
      '@total' => $sandbox['max'],
    ));
  }
}

/**
 * Adds the listing (topic list visibility) column to {entity_forum_topic}.
 *
 * Topics can be listed normally, shown only to moderators (admin_only),
 * or hidden from topic lists entirely (unlisted) while staying viewable
 * at their own URL — the foundation for moderation queues and
 * node-attached comment threads. Existing topics default to 'normal'.
 */
function entity_forum_update_1003() {
  if (!db_field_exists('entity_forum_topic', 'listing')) {
    db_add_field('entity_forum_topic', 'listing', array(
      'type' => 'varchar',
      'length' => 16,
      'not null' => TRUE,
      'default' => 'normal',
      'description' => 'Topic list visibility: normal (listed), admin_only (moderators only), or unlisted (hidden from lists, e.g. node-attached comment threads).',
    ), array('indexes' => array('listing' => array('listing'))));
  }
  // Rebuild the schema cache so entity saves see the new column at once
  // (backdrop_write_record silently drops fields missing from the cache).
  backdrop_get_complete_schema(TRUE);
}

/**
 * Adds the pending (awaiting review) column to topics and replies.
 *
 * Members with the 'review' posting status have their new posts held for
 * moderation: pending topics are hidden via listing = admin_only, pending
 * replies via status = 0 — so the existing visibility machinery covers
 * them and this column only marks what belongs in the moderation queue.
 */
function entity_forum_update_1004() {
  $spec = array(
    'type' => 'int',
    'size' => 'tiny',
    'not null' => TRUE,
    'default' => 0,
    'description' => 'Awaiting moderator review (1 = in the moderation queue).',
  );
  foreach (array('entity_forum_topic', 'entity_forum_reply') as $table) {
    if (!db_field_exists($table, 'pending')) {
      db_add_field($table, 'pending', $spec, array('indexes' => array('pending' => array('pending'))));
    }
  }
  // Rebuild the schema cache so entity saves see the new columns at once
  // (backdrop_write_record silently drops fields missing from the cache).
  backdrop_get_complete_schema(TRUE);
}

/**
 * Adds the {entity_forum_report} table and the pending_reason columns.
 *
 * Reports let members flag content for moderator attention (a plain
 * table, deliberately not an entity so reports can never leak into
 * lists or statistics). pending_reason records WHY a post was held for
 * review — the member's posting status, or a reason set by a
 * third-party moderation module via hook_entity_forum_post_hold_alter().
 */
function entity_forum_update_1005() {
  if (!db_table_exists('entity_forum_report')) {
    $schema = entity_forum_schema();
    db_create_table('entity_forum_report', $schema['entity_forum_report']);
  }
  $spec = array(
    'type' => 'varchar',
    'length' => 64,
    'not null' => TRUE,
    'default' => '',
    'description' => 'Why the post was held for review (e.g. posting_status, or a reason set by a third-party moderation module).',
  );
  foreach (array('entity_forum_topic', 'entity_forum_reply') as $table) {
    if (!db_field_exists($table, 'pending_reason')) {
      db_add_field($table, 'pending_reason', $spec);
    }
  }
  // Rebuild the schema cache so entity saves see the new columns at once.
  backdrop_get_complete_schema(TRUE);
}

/**
 * Adds the node_id (attached content) column to {entity_forum_topic}.
 *
 * A topic with node_id set is the discussion thread of that node —
 * rendered below the node as a comments replacement, unlisted in forum
 * topic lists by default. See the "Content discussions" section of the
 * forum settings.
 */
function entity_forum_update_1006() {
  if (!db_field_exists('entity_forum_topic', 'node_id')) {
    db_add_field('entity_forum_topic', 'node_id', array(
      'type' => 'int',
      'not null' => TRUE,
      'unsigned' => TRUE,
      'default' => 0,
      'description' => 'The {node}.nid this topic is attached to as its discussion thread (0 = a normal forum topic).',
    ), array('indexes' => array('node_id' => array('node_id'))));
  }
  // Rebuild the schema cache so entity saves see the new column at once.
  backdrop_get_complete_schema(TRUE);
}

/**
 * Adds the author_close column to {entity_forum_forum}.
 *
 * Forums with author_close enabled let topic authors close and reopen
 * their own topics — the classified-ads "mark as sold" flow.
 */
function entity_forum_update_1007() {
  if (!db_field_exists('entity_forum_forum', 'author_close')) {
    db_add_field('entity_forum_forum', 'author_close', array(
      'type' => 'int',
      'size' => 'tiny',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Whether topic authors may close/reopen their own topics in this forum (classified ads: mark as sold).',
    ));
  }
  // Rebuild the schema cache so entity saves see the new column at once.
  backdrop_get_complete_schema(TRUE);
}

/**
 * Adds the listed (appear in forum list) column to {entity_forum_forum}.
 *
 * Decouples forum-list appearance from published status: an unlisted
 * forum is hidden from the forums index and sub-forum lists but stays
 * fully usable at its own URL (forum/N) — for forums featured under their
 * own menu link. Existing forums default to listed (1).
 */
function entity_forum_update_1008() {
  if (!db_field_exists('entity_forum_forum', 'listed')) {
    db_add_field('entity_forum_forum', 'listed', array(
      'type' => 'int',
      'size' => 'tiny',
      'not null' => TRUE,
      'default' => 1,
      'description' => 'Whether the forum appears in the forums index and sub-forum lists. Unlisted forums stay fully usable at their own URL (forum/N) — for forums featured under their own menu link. Independent of status (published).',
    ));
  }
  // Rebuild the schema cache so entity saves see the new column at once.
  backdrop_get_complete_schema(TRUE);
}
