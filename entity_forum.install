<?php

/**
 * @file
 * Install, update, and uninstall functions for the Entity Forum module.
 */

/**
 * Implements hook_requirements().
 *
 * Entity Forum provides the forums, forum/* and topic/* paths and replaces the
 * core-style forum modules. Installing it alongside 'forum' or 'forum_ng'
 * would leave the site with two competing forum systems fighting over the
 * same URLs, so installation is blocked while either is enabled, and the
 * status report warns if a conflict (or a leftover path override such as a
 * stale forum_ng view) appears later.
 *
 * @param string $phase
 *   The phase in which requirements are checked: 'install' or 'runtime'.
 *
 * @return array
 *   Requirements array as expected by the hook.
 */
function entity_forum_requirements($phase) {
  $requirements = array();

  $conflicting = array();
  foreach (array('forum', 'forum_ng') as $module) {
    if (module_exists($module)) {
      $conflicting[] = $module;
    }
  }

  if ($phase == 'install' && $conflicting) {
    $requirements['entity_forum_conflict'] = array(
      'title' => t('Entity Forum'),
      'description' => t('Entity Forum cannot be installed while the following conflicting forum module(s) are enabled: %modules. They provide overlapping forum pages and URLs. Disable them before installing Entity Forum — they cannot be active at the same time.', array(
        '%modules' => implode(', ', $conflicting),
      )),
      'severity' => REQUIREMENT_ERROR,
    );
  }

  if ($phase == 'runtime') {
    if ($conflicting) {
      $requirements['entity_forum_conflict'] = array(
        'title' => t('Entity Forum conflicting modules'),
        'value' => t('Enabled: %modules', array('%modules' => implode(', ', $conflicting))),
        'description' => t('Entity Forum and the %modules module(s) cannot be active at the same time: they provide overlapping forum pages and URLs. Disable one of them.', array(
          '%modules' => implode(', ', $conflicting),
        )),
        'severity' => REQUIREMENT_ERROR,
      );
    }
    else {
      $requirements['entity_forum_conflict'] = array(
        'title' => t('Entity Forum conflicting modules'),
        'value' => t('None enabled'),
        'severity' => REQUIREMENT_OK,
      );
    }

    // Even with conflicting modules disabled, a leftover Views page (e.g.
    // the forum_ng view kept in active config) can still override the
    // forums path. Verify Entity Forum actually owns its front page.
    $owner = db_query("SELECT page_callback FROM {menu_router} WHERE path = 'forums'")->fetchField();
    if ($owner && $owner !== 'entity_forum_forums_page') {
      $requirements['entity_forum_path'] = array(
        'title' => t('Entity Forum front page'),
        'value' => t('Overridden'),
        'description' => t('The <a href="@url">forums</a> path is currently served by %callback instead of Entity Forum. A leftover view (such as the forum_ng view) or another module is overriding it. Disable that view at admin/structure/views and clear caches.', array(
          '@url' => url('forums'),
          '%callback' => $owner,
        )),
        'severity' => REQUIREMENT_WARNING,
      );
    }
    else {
      $requirements['entity_forum_path'] = array(
        'title' => t('Entity Forum front page'),
        'value' => t('Served by Entity Forum'),
        'severity' => REQUIREMENT_OK,
      );
    }

    // Privacy recommendation: when forum members can upload images through
    // the editor, the core image library dialog lets them browse EVERY
    // image on the site. The image_library_image_access contrib module
    // limits users to their own uploads (plus a bypass permission).
    $upload_formats = array();
    foreach (filter_formats() as $format) {
      $format_config = config('filter.format.' . $format->format);
      if ($format_config->get('editor') && $format_config->get('editor_settings.image_upload.status')) {
        $upload_formats[] = $format->name;
      }
    }
    if ($upload_formats && !module_exists('image_library_image_access')) {
      $requirements['entity_forum_image_library'] = array(
        'title' => t('Entity Forum image library privacy'),
        'value' => t('Module recommended'),
        'description' => t('The %formats text format(s) allow image uploads via the editor, and the core image library dialog shows every uploaded image on the site to anyone who can browse it. Installing the <a href="@url">Image Library Image Access</a> module is recommended: it limits users to seeing only their own uploads.', array(
          '%formats' => implode(', ', $upload_formats),
          '@url' => 'https://backdropcms.org/project/image_library_image_access',
        )),
        'severity' => REQUIREMENT_WARNING,
      );
    }
    elseif ($upload_formats) {
      $requirements['entity_forum_image_library'] = array(
        'title' => t('Entity Forum image library privacy'),
        'value' => t('Image Library Image Access enabled'),
        'severity' => REQUIREMENT_OK,
      );
    }
  }

  return $requirements;
}

/**
