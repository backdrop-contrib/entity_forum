<?php

/**
 * @file
 * Install, uninstall and schema functions for the Entity Forum module.
  */

/**
 * Implements hook_requirements().
 *
 * Entity Forum provides the forums, forum/* and topic/* paths and replaces.
 * Installing it alongside 'forum' or 'forum_ng' would leave the site with
 * two competing forum systems fighting over the  same URLs, so installation
 * is blocked while either is enabled, and the status report warns if a
 * conflict (or a leftover path override such as a stale forum_ng view)
 * appears later.
 *
 * @param string $phase
 *   The phase in which requirements are checked: 'install' or 'runtime'.
 *
 * @return array
 *   Requirements array as expected by the hook.
 */
function entity_forum_requirements($phase) {
  $requirements = array();

  $conflicting = array();
  foreach (array('forum', 'forum_ng') as $module) {
    if (module_exists($module)) {
      $conflicting[] = $module;
    }
  }

  if ($phase == 'install' && $conflicting) {
    $requirements['entity_forum_conflict'] = array(
      'title' => t('Entity Forum'),
      'description' => t('Entity Forum cannot be installed while the following conflicting forum module(s) are enabled: %modules. They provide overlapping forum pages and URLs. Disable them before installing Entity Forum — they cannot be active at the same time.', array(
        '%modules' => implode(', ', $conflicting),
      )),
      'severity' => REQUIREMENT_ERROR,
    );
  }

  if ($phase == 'runtime') {
    if ($conflicting) {
      $requirements['entity_forum_conflict'] = array(
        'title' => t('Entity Forum conflicting modules'),
        'value' => t('Enabled: %modules', array('%modules' => implode(', ', $conflicting))),
        'description' => t('Entity Forum and the %modules module(s) cannot be active at the same time: they provide overlapping forum pages and URLs. Disable one of them.', array(
          '%modules' => implode(', ', $conflicting),
        )),
        'severity' => REQUIREMENT_ERROR,
      );
    }
    else {
      $requirements['entity_forum_conflict'] = array(
        'title' => t('Entity Forum conflicting modules'),
        'value' => t('None enabled'),
        'severity' => REQUIREMENT_OK,
      );
    }

    // Even with conflicting modules disabled, a leftover Views page (e.g.
    // the forum_ng view kept in active config) can still override the
    // forums path. Verify Entity Forum actually owns its front page: the
    // index is the shipped entity_forum_forums view, so the router entry is
    // views_page with that view as its first page argument, any other
    // callback, or another view's page display, is an override.
    $router = db_query("SELECT page_callback, page_arguments FROM {menu_router} WHERE path = 'forums'")->fetchAssoc();
    $served_by_us = FALSE;
    $owner = '';
    if ($router) {
      $owner = $router['page_callback'];
      if ($owner === 'views_page') {
        $args = @unserialize($router['page_arguments']);
        $view_name = is_array($args) ? reset($args) : '';
        $served_by_us = ($view_name === 'entity_forum_forums');
        // Name the overriding view, not just views_page.
        if (!$served_by_us && $view_name) {
          $owner = t('the %view view', array('%view' => $view_name));
        }
      }
    }
    if ($router && !$served_by_us) {
      $requirements['entity_forum_path'] = array(
        'title' => t('Entity Forum front page'),
        'value' => t('Overridden'),
        'description' => t('The <a href="@url">forums</a> path is currently served by !callback instead of the entity_forum_forums view. A leftover view (such as the forum_ng view) or another module is overriding it. Disable that view at admin/structure/views and clear caches.', array(
          '@url' => url('forums'),
          '!callback' => is_string($owner) ? check_plain($owner) : $owner,
        )),
        'severity' => REQUIREMENT_WARNING,
      );
    }
    else {
      $requirements['entity_forum_path'] = array(
        'title' => t('Entity Forum front page'),
        'value' => t('Served by Entity Forum'),
        'severity' => REQUIREMENT_OK,
      );
    }

    // Privacy recommendation: when forum members can upload images through
    // the editor, the core image library dialog lets them browse EVERY
    // image on the site. The image_library_image_access contrib module
    // limits users to their own uploads (plus a bypass permission).
    $upload_formats = array();
    foreach (filter_formats() as $format) {
      $format_config = config('filter.format.' . $format->format);
      if ($format_config->get('editor') && $format_config->get('editor_settings.image_upload.status')) {
        $upload_formats[] = $format->name;
      }
    }
    if ($upload_formats && !module_exists('image_library_image_access')) {
      $requirements['entity_forum_image_library'] = array(
        'title' => t('Entity Forum image library privacy'),
        'value' => t('Module recommended'),
        'description' => t('The %formats text format(s) allow image uploads via the editor, and the core image library dialog shows every uploaded image on the site to anyone who can browse it. Installing the <a href="@url">Image Library Image Access</a> module is recommended: it limits users to seeing only their own uploads.', array(
          '%formats' => implode(', ', $upload_formats),
          '@url' => 'https://backdropcms.org/project/image_library_image_access',
        )),
        'severity' => REQUIREMENT_WARNING,
      );
    }
    elseif ($upload_formats) {
      $requirements['entity_forum_image_library'] = array(
        'title' => t('Entity Forum image library privacy'),
        'value' => t('Image Library Image Access enabled'),
        'severity' => REQUIREMENT_OK,
      );
    }

    // Uninstall heads-up. Uninstalling drops every forum table AND deletes each
    // field on forum content (with its data) irreversibly - see hook_uninstall.
    // Backdrop offers no hook to veto or annotate the uninstall page itself, so
    // surface what is at risk here and point the owner at the clean path: delete
    // the forums first (each forum's Delete action removes it and everything
    // inside it, releasing attached files as it goes). Shown only while there is
    // forum content or extra fields to lose, and kept at INFO so a healthy site
    // is not nagged.
    $forum_count = (int) db_query('SELECT COUNT(*) FROM {entity_forum_forum}')->fetchField();
    $topic_count = (int) db_query('SELECT COUNT(*) FROM {entity_forum_topic}')->fetchField();
    $reply_count = (int) db_query('SELECT COUNT(*) FROM {entity_forum_reply}')->fetchField();
    $extra_fields = array();
    foreach (array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply') as $entity_type) {
      foreach (field_info_instances($entity_type) as $bundle => $instances) {
        foreach ($instances as $field_name => $instance) {
          // The body is the module's own field; everything else is a field
          // placed on forum content whose data uninstall would take with it.
          if ($field_name !== 'entity_forum_body') {
            $extra_fields[$field_name] = check_plain($instance['label']) . ' (' . $field_name . ')';
          }
        }
      }
    }
    if ($forum_count || $topic_count || $reply_count || $extra_fields) {
      $description = t('Uninstalling Entity Forum permanently deletes all forum content and cannot be undone. To remove it cleanly first, delete your forums from the <a href="@forums">forum overview</a> — each forum\'s <em>Delete</em> action removes the forum and everything inside it (topics, replies and their file attachments).', array(
        '@forums' => url('admin/content/entity-forum'),
      ));
      if ($extra_fields) {
        $description .= ' ' . t('Uninstalling will also delete these fields on forum content, along with all their data: %fields. Export anything you need to keep before uninstalling.', array(
          '%fields' => implode(', ', $extra_fields),
        ));
      }
      $requirements['entity_forum_uninstall_notice'] = array(
        'title' => t('Entity Forum content'),
        'value' => t('@f forum(s), @t topic(s), @r reply(ies)', array(
          '@f' => $forum_count,
          '@t' => $topic_count,
          '@r' => $reply_count,
        )),
        'description' => $description,
        'severity' => REQUIREMENT_INFO,
      );
    }
  }

  return $requirements;
}

/**
 * Implements hook_install().
 *
 * Seeds the body field on the default topic type. A topic's and a reply's
 * body is the entity_forum_body field rather than a base column, so a forum
 * builder chooses its widget and text format per topic type, this is the
 * install-time counterpart of node_add_body_field() on a fresh content type.
 * Every topic type created afterwards seeds its own body in
 * entity_forum_topic_type_form_submit().
 *
 * Also seeds the demo "classified" topic type's body, and the starter forums.
 * The classified type, its ad fields and the grid view ship as config (imported
 * before this hook runs); only the body field (code-seeded like the default
 * type's, not shipped as config) and the forum ENTITIES are created here, a
 * forum is a table row, not config. The starter forums let a fresh site show
 * off a plain forum and a fielded classified section out of the box, and are
 * removable afterwards from the settings page.
 */
function entity_forum_install() {
  // The module is enabled (its entity types are registered with Field API)
  // before hook_install runs, so the body field can be attached now.
  entity_forum_topic_type_add_body(ENTITY_FORUM_TOPIC_TYPE_DEFAULT);

  // The classified demo type's config (type + ad fields + grid view) is
  // already imported; seed its body the same way as the default type.
  entity_forum_topic_type_add_body('classified');

  entity_forum_install_starter_forums();
}

/**
 * Creates the starter demo forums and records their IDs.
 *
 * Three forums that demonstrate the module out of the box: a plain "General
 * Discussion" on the default type; a "Classified Ads" container (topic type
 * "- None -", so it only groups sub-forums); and an "Items for Sale" child on
 * the classified type, wired to the shipped ad grid view. Forums are entities,
 * so they cannot ship as config and are created here at install.
 *
 * The IDs are stored in entity_forum.settings so the settings page can offer
 * to remove exactly these forums later (a site that wants a clean slate), and
 * only while they still exist.
 */
function entity_forum_install_starter_forums() {
  $format = filter_default_format();

  $general = _entity_forum_create_starter_forum(array(
    'title' => 'General Discussion',
    'description' => 'A place for general chat — the standard forum, out of the box.',
    'weight' => 0,
    'topic_type' => ENTITY_FORUM_TOPIC_TYPE_DEFAULT,
  ), $format);

  $classified = _entity_forum_create_starter_forum(array(
    'title' => 'Classified Ads',
    'description' => "Members' classified adverts.",
    'weight' => 10,
    // "- None -": a container that only groups sub-forums, nothing is posted
    // directly in it.
    'topic_type' => ENTITY_FORUM_FORUM_TOPIC_TYPE_NONE,
  ), $format);

  $items = _entity_forum_create_starter_forum(array(
    'title' => 'Items for Sale',
    'description' => 'Items offered for sale by members.',
    'parent_id' => $classified,
    'weight' => 0,
    // Sellers can mark their own ad sold.
    'author_close' => TRUE,
    'topic_type' => 'classified',
    'topic_view' => 'forum_topics_classified:default',
  ), $format);

  config_set('entity_forum.settings', 'starter_forum_ids', array($general, $classified, $items));
}

/**
 * Creates one starter forum entity from a small property array.
 *
 * @param array $props
 *   Forum properties: title (required), description, parent_id, weight,
 *   author_close, topic_type (required), topic_view.
 * @param string $format
 *   Text format machine name for the description.
 *
 * @return int
 *   The new forum's ID.
 */
function _entity_forum_create_starter_forum(array $props, $format) {
  $forum = entity_create('entity_forum_forum', array());
  $forum->title = $props['title'];
  $forum->description = isset($props['description']) ? $props['description'] : '';
  $forum->description_format = $format;
  $forum->parent_id = isset($props['parent_id']) ? (int) $props['parent_id'] : 0;
  $forum->visibility = 'public';
  $forum->weight = isset($props['weight']) ? (int) $props['weight'] : 0;
  $forum->status = 1;
  $forum->listed = 1;
  $forum->author_close = !empty($props['author_close']) ? 1 : 0;
  $forum->topic_type = $props['topic_type'];
  $forum->topic_view = isset($props['topic_view']) ? $props['topic_view'] : '';
  $forum->changed = REQUEST_TIME;
  $forum->save();
  return (int) $forum->id();
}

/**
 * Implements hook_uninstall().
 *
 * Core drops this module's own schema tables, but NOT the Field API config and
 * storage for fields attached to its entity types, nor the config the module
 * ships. Left behind, they orphan (a deleted topic type's field bundle and
 * instances linger with no type) and collide on a later reinstall/reimport —
 * `field_create_field()` finds `entity_forum_body` already present and its data
 * table still populated. So remove it all here.
 *
 * This includes any fields a SITE added to forum content (attachments, a price,
 * …): they hang off the entity types being removed, so they cannot survive.
 * That destruction is inherent to uninstalling, the guard against doing it
 * unawares is a warning, not a block (core offers no clean way to veto an
 * uninstall).
 *
 * The importer owns the forum-attachments FILES on disk, so their cleanup is
 * its concern, not this module's; field data referencing them is removed here,
 * which drops the file usages and lets file GC collect the now-unused files.
 */
function entity_forum_uninstall() {
  // 1. Every field instance on the three entity types, the module's body
  //    field, site-added fields, and instances on any orphaned bundle (a topic
  //    type whose config is already gone).
  //    Pass FALSE for $field_cleanup, NOT TRUE: core's field_delete_instance()
  //    does count($field['bundles'][$entity_type]) in the cleanup branch AFTER
  //    unsetting that key, which is a fatal count(null) on PHP 8 as soon as the
  //    last instance of a field is removed (field.crud.inc ~901). It aborts the
  //    loop mid-way and orphans the remaining instance config. We delete the
  //    now-empty fields ourselves below instead.
  $field_names = array();
  foreach (array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply') as $entity_type) {
    foreach (field_read_instances(array('entity_type' => $entity_type), array('include_inactive' => TRUE)) as $instance) {
      $field_names[$instance['field_name']] = $instance['field_name'];
      field_delete_instance($instance, FALSE);
    }
  }

  // Delete each field that no longer has an instance anywhere, its data table
  // is dropped by the purge below. A field a site also put on another entity
  // type (a shared field) still has instances, so it is left alone.
  foreach ($field_names as $field_name) {
    if (!field_read_instances(array('field_name' => $field_name), array('include_inactive' => TRUE))) {
      field_delete_field($field_name);
    }
  }

  // Purge now so the field_data_*/field_revision_* tables are dropped here
  // rather than at a later cron run.
  field_purge_batch(10000);

  // field_purge_batch() can strand an instance's CONFIG (left marked
  // deleted = 1) when its field is purged before the instance is, and
  // config_install_default_config() SKIPS any config name that already exists,
  // so on a later reinstall the shipped field instances silently fail to
  // re-materialise: the classified demo type would come back with only its body
  // and none of its ad fields. Sweep every instance config still sitting on our
  // three entity types so a reinstall imports them clean. These names are always
  // ours (instances ON our entity types); a field a site also placed on another
  // entity type lives under a different prefix (e.g. field.instance.node.*) and
  // is left untouched.
  foreach (array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply') as $entity_type) {
    foreach (config_get_names_with_prefix('field.instance.' . $entity_type . '.') as $name) {
      config($name)->delete();
    }
  }

  // 2. Field UI bundle settings config left behind for our entity types.
  foreach (config_get_names_with_prefix('field.bundle.entity_forum_') as $name) {
    config($name)->delete();
  }

  // 3. The module's config: topic types (including any orphaned type config),
  //    settings, and the shipped image styles and views.
  $names = array(
    'entity_forum.settings',
    'image.style.entity_forum_avatar',
    'image.style.entity_forum_avatar_small',
    'views.view.entity_forum_topics',
    'views.view.entity_forum_topics_admin',
    'views.view.entity_forum_forums_admin',
    'views.view.entity_forum_forums',
    'views.view.forum_replies_admin',
    'views.view.forum_topics_classified',
  );
  foreach (config_get_names_with_prefix('entity_forum.type.') as $name) {
    $names[] = $name;
  }
  foreach ($names as $name) {
    config($name)->delete();
  }
}

/**
 * Implements hook_schema().
 */
function entity_forum_schema() {
  $schema['entity_forum_forum'] = array(
    'description' => 'Stores forum containers.',
    'fields' => array(
      'forum_id' => array(
        'type' => 'serial',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'description' => 'Primary Key: Unique forum ID.',
      ),
      'title' => array(
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The title of the forum.',
      ),
      'description' => array(
        'type' => 'text',
        'size' => 'medium',
        'not null' => FALSE,
        'description' => 'Description of the forum, run through description_format.',
      ),
      'description_format' => array(
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'Text format machine name for the description, so a forum description can carry markup like any other rich text.',
      ),
      'status' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
        'description' => 'Published status (1 = published, 0 = unpublished).',
      ),
      'parent_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'default' => 0,
        'description' => 'The parent forum ID for nested forums (0 = top level).',
      ),
      'visibility' => array(
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'public',
        'description' => 'Visibility of the forum: public or private.',
      ),
      'weight' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Sort order of the forum in listings (lower first).',
      ),
      'created' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the forum was created.',
      ),
      'changed' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the forum was last updated.',
      ),
      'author_uid' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The {users}.uid of the forum author. Kept as the "last uid" even after the account is deleted, for reinstatement.',
      ),
      'author_name' => array(
        'type' => 'varchar',
        'length' => 60,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Snapshot of the author display name at save time; shown when the account no longer exists.',
      ),
      'author_close' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Whether topic authors may close/reopen their own topics in this forum (e.g. an author marking their own support question resolved).',
      ),
      'topic_type' => array(
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'entity_forum_topic',
        'description' => 'The topic type every topic posted in this forum takes. Set on the forum, so posting never asks: a support forum takes support topics. Use a sub-forum for a different kind of topic.',
      ),
      'topic_view' => array(
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The view display rendering this forum\'s topic list, as "view_name:display_id". Empty means the shipped default — so a site that never chooses one follows the module, and a photo-gallery forum can render as a thumbnail grid while the discussion forums stay a topic table. Read it through entity_forum_forum_topic_list_view(), which falls back to the default if the named view has since been deleted.',
      ),
      'listed' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
        'description' => 'Whether the forum appears in the forums index and sub-forum lists. Unlisted forums stay fully usable at their own URL (forum/N) — for forums featured under their own menu link. Independent of status (published).',
      ),
    ),
    'primary key' => array('forum_id'),
    'indexes' => array(
      'status' => array('status'),
      'parent_id' => array('parent_id'),
      'author_uid' => array('author_uid'),
    ),
  );

  $schema['entity_forum_topic'] = array(
    'description' => 'Stores forum topics (discussion threads).',
    'fields' => array(
      'topic_id' => array(
        'type' => 'serial',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'description' => 'Primary Key: Unique topic ID.',
      ),
      'type' => array(
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'entity_forum_topic',
        'description' => 'The topic type (bundle): the machine name of an entity_forum topic type. Never empty — entity_extract_ids() throws on a missing bundle.',
      ),
      'title' => array(
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The title of the topic.',
      ),
      // The opening post body is the entity_forum_body field (one instance per
      // topic type), not a column, a forum builder picks its widget and text
      // format per type through Field UI. See entity_forum_add_body_field().
      'status' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
        'description' => 'Published status (1 = published, 0 = unpublished).',
      ),
      'forum_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'description' => 'The {entity_forum_forum}.forum_id this topic belongs to.',
      ),
      'author_uid' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The {users}.uid of the topic author. Kept as the "last uid" even after the account is deleted, for reinstatement.',
      ),
      'author_name' => array(
        'type' => 'varchar',
        'length' => 60,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Snapshot of the author display name at save time; shown when the account no longer exists.',
      ),
      'created' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the topic was created.',
      ),
      'changed' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the topic was last updated.',
      ),
      'sticky' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Sticky topics sort first in the forum topic list.',
      ),
      'closed' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Closed topics accept no new replies.',
      ),
      'listing' => array(
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'normal',
        'description' => 'Topic list visibility: normal (listed), admin_only (moderators only), or unlisted (hidden from lists, e.g. node-attached comment threads).',
      ),
      'pending' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Awaiting moderator review (1 = in the moderation queue). Pending topics are held with listing = admin_only.',
      ),
      'pending_reason' => array(
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Why the post was held for review (e.g. posting_status, or a reason set by a third-party moderation module).',
      ),
      'node_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'default' => 0,
        'description' => 'The {node}.nid this topic is attached to as its discussion thread (0 = a normal forum topic).',
      ),
      'reply_count' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'default' => 0,
        'description' => 'Denormalized count of published replies.',
      ),
      'last_reply_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'default' => 0,
        'description' => 'Denormalized {entity_forum_reply}.reply_id of the newest published reply.',
      ),
      'last_active_time' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Denormalized Unix timestamp of the latest activity.',
      ),
      'voice_count' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'default' => 1,
        'description' => 'Denormalized count of distinct participants (topic author plus published repliers) — the bbPress "Voices".',
      ),
      'attachment_count' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'default' => 0,
        'description' => 'Denormalized count of {file_usage} attachments on the topic and its published replies.',
      ),
    ),
    'primary key' => array('topic_id'),
    'indexes' => array(
      'status' => array('status'),
      'forum_id' => array('forum_id'),
      'author_uid' => array('author_uid'),
      'forum_listing' => array('forum_id', 'status', 'sticky', 'last_active_time'),
      'listing' => array('listing'),
      'pending' => array('pending'),
      'node_id' => array('node_id'),
      'type' => array('type'),
    ),
  );

  $schema['entity_forum_reply'] = array(
    'description' => 'Stores replies to forum topics.',
    'fields' => array(
      'reply_id' => array(
        'type' => 'serial',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'description' => 'Primary Key: Unique reply ID.',
      ),
      'type' => array(
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'entity_forum_topic',
        'description' => 'The reply type (bundle). Denormalized from its topic, exactly like forum_id: a reply in an Events topic is an Events reply, so a site can give it its own fields (an attendee count on an RSVP, say). Never empty — entity_extract_ids() throws on a missing bundle.',
      ),
      // The reply body is the entity_forum_body field (one instance per topic
      // type, shared with topics), not a column. See entity_forum_add_body_field().
      'status' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
        'description' => 'Published status (1 = published, 0 = unpublished).',
      ),
      'topic_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'description' => 'The {entity_forum_topic}.topic_id this reply belongs to.',
      ),
      'forum_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'description' => 'The {entity_forum_forum}.forum_id, denormalized for querying.',
      ),
      'author_uid' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The {users}.uid of the reply author. Kept as the "last uid" even after the account is deleted, for reinstatement.',
      ),
      'author_name' => array(
        'type' => 'varchar',
        'length' => 60,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Snapshot of the author display name at save time; shown when the account no longer exists.',
      ),
      'created' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the reply was created.',
      ),
      'changed' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the reply was last updated.',
      ),
      'reply_to_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'default' => 0,
        'description' => 'Parent {entity_forum_reply}.reply_id when threaded (0 = direct reply to topic).',
      ),
      'pending' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Awaiting moderator review (1 = in the moderation queue). Pending replies are held with status = 0.',
      ),
      'pending_reason' => array(
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Why the post was held for review (e.g. posting_status, or a reason set by a third-party moderation module).',
      ),
    ),
    'primary key' => array('reply_id'),
    'indexes' => array(
      'status' => array('status'),
      'topic_id' => array('topic_id'),
      'type' => array('type'),
      'forum_id' => array('forum_id'),
      'author_uid' => array('author_uid'),
      'reply_to_id' => array('reply_to_id'),
      'topic_listing' => array('topic_id', 'status', 'created'),
      'pending' => array('pending'),
    ),
  );

  $schema['entity_forum_report'] = array(
    'description' => 'Member reports of forum content for moderator attention. A plain table, not an entity: reports never appear in lists or counts, so they cannot pollute the denormalized topic statistics.',
    'fields' => array(
      'report_id' => array(
        'type' => 'serial',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'description' => 'Primary Key: Unique report ID.',
      ),
      'entity_type' => array(
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'description' => 'The reported entity type: entity_forum_topic or entity_forum_reply.',
      ),
      'entity_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'description' => 'The reported entity ID.',
      ),
      'reporter_uid' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The {users}.uid of the reporter. Flipped to negative ("last uid") when the account is deleted.',
      ),
      'reporter_name' => array(
        'type' => 'varchar',
        'length' => 60,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Snapshot of the reporter display name at report time.',
      ),
      'reason' => array(
        'type' => 'text',
        'size' => 'medium',
        'not null' => FALSE,
        'description' => 'Why the content was reported, in the reporter\'s words.',
      ),
      'created' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the report was made.',
      ),
      'resolved' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Whether a moderator has resolved the report (1 = resolved).',
      ),
      'resolved_uid' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The {users}.uid of the moderator who resolved the report.',
      ),
      'resolved_time' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the report was resolved.',
      ),
    ),
    'primary key' => array('report_id'),
    'indexes' => array(
      'resolved' => array('resolved'),
      'target' => array('entity_type', 'entity_id'),
      'reporter_uid' => array('reporter_uid'),
    ),
  );

  $schema['entity_forum_migrate_map'] = array(
    'description' => 'Maps IDs in a migration source to the Entity Forum entities imported from them, making imports idempotent and re-runnable.',
    'fields' => array(
      'entity_type' => array(
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'description' => "What kind of thing the row maps to: usually an Entity Forum entity type, but importers also use their own markers (e.g. 'file', 'user_avatar') for one-time work they must not repeat. This is the column that separates ID spaces — an importer reading two of them (bbPress replies from {wp_posts} and page comments from {wp_comments}, say) gives each its own marker so their IDs cannot collide.",
      ),
      'source_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'description' => "The record's ID in the source system — a {wp_posts}.ID for the bbPress importer, a nid/tid/cid for a forum/forum_ng converter. Unique within its entity_type, which is what keeps two ID spaces apart.",
      ),
      'backdrop_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'description' => 'The imported entity ID.',
      ),
      'migrated' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp of the import.',
      ),
    ),
    'primary key' => array('entity_type', 'source_id'),
    'indexes' => array(
      'backdrop_id' => array('entity_type', 'backdrop_id'),
    ),
  );

  return $schema;
}
