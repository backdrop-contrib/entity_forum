        'type' => 'text',
        'size' => 'medium',
        'not null' => FALSE,
        'description' => 'Plain-text description of the forum.',
      ),
      'status' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
        'description' => 'Published status (1 = published, 0 = unpublished).',
      ),
      'parent_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'unsigned' => TRUE,
        'default' => 0,
        'description' => 'The parent forum ID for nested forums (0 = top level).',
