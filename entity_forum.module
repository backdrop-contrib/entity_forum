  );

  return $info;
}

/**
 * Implements hook_autoload_info().
 */
function entity_forum_autoload_info() {
  return array(
    'EntityForumForum' => 'includes/entity_forum.entity.inc',
    'EntityForumTopic' => 'includes/entity_forum.entity.inc',
    'EntityForumReply' => 'includes/entity_forum.entity.inc',
    'entity_forum_handler_field_avatar' => 'views/entity_forum_handler_field_avatar.inc',
    'entity_forum_handler_field_forum_count' => 'views/entity_forum_handler_field_forum_count.inc',
  );
}

/**
 * Implements hook_views_data_alter().
 *
 * Adds an "Author picture" field to topics and replies, rendering the
 * author's forum picture (see entity_forum_format_avatar()) from the
 * row's author_uid. A custom handler because the picture is module-owned
 * account data, not a user field Views could reach via a relationship.
 */
function entity_forum_views_data_alter(&$data) {
  foreach (array('entity_forum_topic', 'entity_forum_reply') as $table) {
    if (isset($data[$table])) {
      $data[$table]['author_avatar'] = array(
        'title' => t('Author picture'),
        'help' => t("The author's forum picture, rendered with an image style."),
        'field' => array(
          'handler' => 'entity_forum_handler_field_avatar',
          'real field' => 'author_uid',
          'click sortable' => FALSE,
        ),
      );
    }
  }

  // Aggregate count fields on the forum base table, so a forums-list View
  // can show per-forum totals (rolled up to include sub-forums) without
  // any per-row count queries — they all read the cached counts map from
  // entity_forum_forum_counts(). See entity_forum_handler_field_forum_count.
  if (isset($data['entity_forum_forum'])) {
    $data['entity_forum_forum']['topic_count'] = array(
      'title' => t('Topic count'),
      'help' => t('Published topics in this forum and its sub-forums.'),
      'field' => array(
        'handler' => 'entity_forum_handler_field_forum_count',
        'real field' => 'forum_id',
        'count key' => 'topic_count',
        'click sortable' => FALSE,
      ),
    );
    $data['entity_forum_forum']['post_count'] = array(
      'title' => t('Post count'),
      'help' => t('Topics plus published replies in this forum and its sub-forums (bbPress "Posts").'),
      'field' => array(
        'handler' => 'entity_forum_handler_field_forum_count',
        'real field' => 'forum_id',
        'count key' => 'post_count',
        'click sortable' => FALSE,
      ),
    );
    $data['entity_forum_forum']['reply_count'] = array(
      'title' => t('Reply count'),
      'help' => t('Published replies in this forum and its sub-forums.'),
      'field' => array(
        'handler' => 'entity_forum_handler_field_forum_count',
        'real field' => 'forum_id',
        'count key' => 'reply_count',
        'click sortable' => FALSE,
      ),
    );
    $data['entity_forum_forum']['forum_last_active'] = array(
      'title' => t('Last activity'),
      'help' => t('Newest activity time in this forum or its sub-forums.'),
      'field' => array(
        'handler' => 'entity_forum_handler_field_forum_count',
        'real field' => 'forum_id',
        'count key' => 'last_active_time',
        'is date' => TRUE,
        'click sortable' => FALSE,
      ),
    );
  }
}

