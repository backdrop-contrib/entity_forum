<?php

/**
 * @file
 * Entity Forum: a bbPress-style forum built on custom entities.
 *
 * Provides three entity types managed by EntityPlusController:
 * - entity_forum_forum: forum containers (nestable, public or private).
 * - entity_forum_topic: discussion threads within a forum.
 * - entity_forum_reply: replies to a topic (optionally threaded).
 *
 * Frontend pages live in entity_forum.pages.inc, admin UI in entity_forum.admin.inc,
 * entity classes in includes/entity_forum.entity.inc.
 */

/**
 * The topic type (bundle) every site starts with.
 *
 * Deliberately named after the entity type rather than something tidier like
 * 'topic': field instances created before topics were bundleable already live
 * on a bundle of this name, so keeping it means existing sites need no
 * field_config_instance rewrite — only a column backfill. Sites are free to
 * add further types; nothing in the module treats this one as special beyond
 * being the fallback for a topic that arrives without a type.
 */
define('ENTITY_FORUM_TOPIC_TYPE_DEFAULT', 'entity_forum_topic');

/**
 * A forum's topic_type when it accepts no topics at all.
 *
 * The "- None -" option on the forum form: the forum is a container holding
 * only sub-forums, the phpBB/bbPress "category". Deliberately the empty
 * string rather than a reserved machine name, so it can never collide with a
 * type a site creates.
 */
define('ENTITY_FORUM_FORUM_TOPIC_TYPE_NONE', '');

/**
 * The view and display rendering a forum's topic list unless told otherwise.
 *
 * The shipped view, which is also the one sitedevs copy and amend. A forum
 * storing an empty topic_view resolves to this, so the default follows the
 * module rather than being frozen into every forum row at save time.
 */
define('ENTITY_FORUM_TOPIC_LIST_VIEW_DEFAULT', 'entity_forum_topics:default');

/**
 * Topic listing modes: how a topic appears in forum topic lists.
 *
 * - normal: listed for everyone who can view the forum.
 * - admin_only: listed only for moderators (for review/moderation); the
 *   topic page itself is also restricted to moderators.
 * - unlisted: never listed, but the topic page stays viewable at its own
 *   URL — used for e.g. node-attached comment threads.
 */
define('ENTITY_FORUM_LISTING_NORMAL', 'normal');
define('ENTITY_FORUM_LISTING_ADMIN_ONLY', 'admin_only');
define('ENTITY_FORUM_LISTING_UNLISTED', 'unlisted');

/**
 * Returns the topic listing mode options for select elements.
 *
 * @return array
 *   Options keyed by listing machine name.
 */
function entity_forum_topic_listing_options() {
  return array(
    ENTITY_FORUM_LISTING_NORMAL => t('Shown in the forum topic list'),
    ENTITY_FORUM_LISTING_ADMIN_ONLY => t('Shown only to moderators (for moderation)'),
    ENTITY_FORUM_LISTING_UNLISTED => t('Not shown in the forum topic list'),
  );
}

/**
 * Member posting statuses: how a member's new posts are treated.
 *
 * - normal: posts appear immediately (the default; not stored).
 * - review: every new topic and reply is held for moderator approval
 *   before it becomes visible (pending flag + the existing hold
 *   machinery: admin_only listing for topics, unpublished for replies).
 * - suspended: the member cannot post at all.
 */
define('ENTITY_FORUM_POSTING_NORMAL', 'normal');
define('ENTITY_FORUM_POSTING_REVIEW', 'review');
define('ENTITY_FORUM_POSTING_SUSPENDED', 'suspended');

/**
 * Returns the member posting status options for select elements.
 *
 * @return array
 *   Options keyed by posting status machine name.
 */
function entity_forum_posting_status_options() {
  return array(
    ENTITY_FORUM_POSTING_NORMAL => t('Normal — posts appear immediately'),
    ENTITY_FORUM_POSTING_REVIEW => t('Review — posts are held until a moderator approves them'),
    ENTITY_FORUM_POSTING_SUSPENDED => t('Suspended — cannot post topics or replies'),
  );
}

/**
 * Returns a member's forum posting status.
 *
 * Stored in the account data array like the posting name; absent means
 * normal. Anonymous (and gone) accounts report normal — they are gated
 * by permissions, not posting status.
 *
 * @param object|int|null $account
 *   A user account or uid; defaults to the current user.
 *
 * @return string
 *   One of the ENTITY_FORUM_POSTING_* values.
 */
function entity_forum_user_posting_status($account = NULL) {
  if (!isset($account)) {
    $account = $GLOBALS['user'];
  }
  if (is_numeric($account)) {
    $account = $account > 0 ? user_load($account) : FALSE;
  }
  if ($account && !empty($account->data['entity_forum_posting_status'])) {
    $status = $account->data['entity_forum_posting_status'];
    if (in_array($status, array(ENTITY_FORUM_POSTING_REVIEW, ENTITY_FORUM_POSTING_SUSPENDED), TRUE)) {
      return $status;
    }
  }
  return ENTITY_FORUM_POSTING_NORMAL;
}

/**
 * Saves a member's forum posting status.
 *
 * 'normal' removes the entry from the account data array so unrestricted
 * members carry no marker at all.
 *
 * @param object $account
 *   The account the status applies to.
 * @param string $status
 *   One of the ENTITY_FORUM_POSTING_* values.
 */
function entity_forum_posting_status_save($account, $status) {
  $data = $account->data;
  if ($status === ENTITY_FORUM_POSTING_REVIEW || $status === ENTITY_FORUM_POSTING_SUSPENDED) {
    $data['entity_forum_posting_status'] = $status;
  }
  else {
    unset($data['entity_forum_posting_status']);
  }
  db_update('users')
    ->fields(array('data' => serialize($data)))
    ->condition('uid', $account->uid)
    ->execute();
  $account->data = $data;
  entity_get_controller('user')->resetCache(array($account->uid));
}

/**
 * Decides whether a new frontend post must be held for moderator review.
 *
 * The built-in rule holds posts by members with the 'review' posting
 * status. Other modules can add their own rules (AI moderation,
 * probation periods, ...) via hook_entity_forum_post_hold_alter() —
 * see entity_forum.api.php. Called by the frontend topic and reply form
 * submits before the entity is saved; the hold itself uses the existing
 * machinery (admin_only listing for topics, unpublished for replies)
 * plus the pending flag, with the reason recorded in pending_reason.
 *
 * @param object $entity
 *   The unsaved topic or reply, with content already set.
 * @param string $entity_type
 *   entity_forum_topic or entity_forum_reply.
 * @param object|null $account
 *   The posting account; defaults to the current user.
 *
 * @return array
 *   Array with:
 *   - hold: (bool) TRUE to hold the post for review.
 *   - reason: (string) short machine reason shown to moderators in the
 *     queue (max 64 chars stored), e.g. 'posting_status'.
 */
function entity_forum_post_hold($entity, $entity_type, $account = NULL) {
  if (!isset($account)) {
    $account = $GLOBALS['user'];
  }
  $hold = array(
    'hold' => entity_forum_user_posting_status($account) === ENTITY_FORUM_POSTING_REVIEW,
    'reason' => 'posting_status',
  );
  $context = array(
    'entity' => $entity,
    'entity_type' => $entity_type,
    'account' => $account,
  );
  backdrop_alter('entity_forum_post_hold', $hold, $context);
  return $hold;
}

/**
 * Returns the human label for a pending_reason value in the queue.
 *
 * @param string $reason
 *   The stored pending_reason.
 *
 * @return string
 *   Sanitized label.
 */
function entity_forum_pending_reason_label($reason) {
  if ($reason === 'posting_status') {
    return t('Member posting status');
  }
  return $reason === '' ? '' : check_plain($reason);
}

/**
 * Whether an account is a forum moderator.
 *
 * Moderators see moderation panels and held (admin_only) topics, work the
 * moderation queue, and set member posting statuses. The dedicated
 * 'moderate entity forum' permission grants it; the broader administer
 * permissions imply it.
 *
 * @param object|null $account
 *   The user to check; defaults to the current user.
 *
 * @return bool
 *   TRUE when the account may moderate.
 */
function entity_forum_user_is_moderator($account = NULL) {
  return user_access('moderate entity forum', $account)
    || user_access('administer entity forum topic', $account)
    || user_access('administer entity forum', $account);
}

/**
 * Implements hook_entity_info().
 */
function entity_forum_entity_info() {
  $info = array();

  // Topics and replies share one set of bundles: the site's topic types. A
  // reply's type is derived from its topic (a reply in a Classified topic is
  // a Classified reply), so reply fields are managed under the topic type
  // rather than in a parallel type system of their own.
  $topic_bundles = array();
  $reply_bundles = array();
  foreach (entity_forum_topic_types() as $machine_name => $topic_type) {
    $type_path = 'admin/structure/entity-forum/topic-types/' . str_replace('_', '-', $machine_name);
    $topic_bundles[$machine_name] = array(
      'label' => $topic_type->label,
      'admin' => array(
        'path' => 'admin/structure/entity-forum/topic-types/%entity_forum_topic_type',
        'real path' => $type_path,
        'bundle argument' => 4,
        'access arguments' => array('administer entity forum'),
      ),
    );
    $reply_bundles[$machine_name] = array(
      'label' => t('Replies in @type topics', array('@type' => $topic_type->label)),
      'admin' => array(
        'path' => 'admin/structure/entity-forum/topic-types/%entity_forum_topic_type/replies',
        'real path' => $type_path . '/replies',
        'bundle argument' => 4,
        'access arguments' => array('administer entity forum'),
      ),
    );
  }

  $info['entity_forum_forum'] = array(
    'label' => t('Entity Forum'),
    'plural label' => t('Entity Forums'),
    'description' => t('A forum container holding discussion topics.'),
    'entity class' => 'EntityForumForum',
    'controller class' => 'EntityPlusController',
    'module' => 'entity_forum',
    'base table' => 'entity_forum_forum',
    'fieldable' => TRUE,
    'entity keys' => array(
      'id' => 'forum_id',
      'label' => 'title',
    ),
    'bundles' => array(
      'entity_forum_forum' => array(
        'label' => t('Entity Forum'),
        'admin' => array(
          'path' => 'admin/structure/entity-forum/forum',
          'access arguments' => array('administer entity forum'),
        ),
      ),
    ),
    'view modes' => array(
      'full' => array(
        'label' => t('Full'),
        'custom settings' => FALSE,
      ),
    ),
    'uri callback' => 'entity_forum_forum_uri',
    'access callback' => 'entity_forum_forum_access',
  );

  $info['entity_forum_topic'] = array(
    'label' => t('Entity Forum Topic'),
    'plural label' => t('Entity Forum Topics'),
    'description' => t('A discussion thread within a forum.'),
    'entity class' => 'EntityForumTopic',
    'controller class' => 'EntityPlusController',
    'module' => 'entity_forum',
    'base table' => 'entity_forum_topic',
    'fieldable' => TRUE,
    'entity keys' => array(
      'id' => 'topic_id',
      'label' => 'title',
      'bundle' => 'type',
    ),
    // Which property of a topic TYPE object holds the bundle name. Distinct
    // from entity keys' 'bundle', which is the property on a topic itself —
    // field_extract_bundle() reads this one to turn the object returned by
    // entity_forum_topic_type_load() back into a bundle name, and Field UI's
    // menu loader depends on it.
    'bundle keys' => array(
      'bundle' => 'type',
    ),
    // One bundle per site-defined topic type. 'bundle argument' tells Field
    // UI which path slice holds the type, so it can hang its Manage fields /
    // Manage display tabs off each type's edit page (the core node pattern).
    'bundles' => $topic_bundles,
    'view modes' => array(
      'full' => array(
        'label' => t('Full'),
        'custom settings' => FALSE,
      ),
    ),
    'uri callback' => 'entity_forum_topic_uri',
    'access callback' => 'entity_forum_topic_access',
  );

  $info['entity_forum_reply'] = array(
    'label' => t('Entity Forum Reply'),
    'plural label' => t('Entity Forum Replies'),
    'description' => t('A reply to a forum topic.'),
    'entity class' => 'EntityForumReply',
    'controller class' => 'EntityPlusController',
    'module' => 'entity_forum',
    'base table' => 'entity_forum_reply',
    'fieldable' => TRUE,
    'entity keys' => array(
      'id' => 'reply_id',
      'bundle' => 'type',
    ),
    // See the topic type's note: this names the property on a topic TYPE
    // object, which field_extract_bundle() reads; the entity key above names
    // the property on a reply.
    'bundle keys' => array(
      'bundle' => 'type',
    ),
    'bundles' => $reply_bundles,
    'view modes' => array(
      'full' => array(
        'label' => t('Full'),
        'custom settings' => FALSE,
      ),
    ),
    'uri callback' => 'entity_forum_reply_uri',
    'access callback' => 'entity_forum_reply_access',
  );

  return $info;
}

/**
 * Implements hook_autoload_info().
 */
function entity_forum_autoload_info() {
  return array(
    'EntityForumForum' => 'includes/entity_forum.entity.inc',
    'EntityForumTopic' => 'includes/entity_forum.entity.inc',
    'EntityForumReply' => 'includes/entity_forum.entity.inc',
    'entity_forum_handler_field_avatar' => 'views/entity_forum_handler_field_avatar.inc',
    'entity_forum_handler_field_forum_count' => 'views/entity_forum_handler_field_forum_count.inc',
    'entity_forum_handler_area_post_link' => 'views/entity_forum_handler_area_post_link.inc',
  );
}

/**
 * Implements hook_views_data_alter().
 *
 * Adds an "Author picture" field to topics and replies, rendering the
 * author's forum picture (see entity_forum_format_avatar()) from the
 * row's author_uid. A custom handler because the picture is module-owned
 * account data, not a user field Views could reach via a relationship.
 */
function entity_forum_views_data_alter(&$data) {
  foreach (array('entity_forum_topic', 'entity_forum_reply') as $table) {
    if (isset($data[$table])) {
      $data[$table]['author_avatar'] = array(
        'title' => t('Author picture'),
        'help' => t("The author's forum picture, rendered with an image style."),
        'field' => array(
          'handler' => 'entity_forum_handler_field_avatar',
          'real field' => 'author_uid',
          'click sortable' => FALSE,
        ),
      );
    }
  }

  // Header/footer area: the "Post new topic" link, access-checked. Views'
  // own Text area cannot do this — it has no idea who is looking, and a
  // display's access setting gates the whole view rather than one region.
  if (isset($data['entity_forum_topic'])) {
    $data['entity_forum_topic']['post_link'] = array(
      'title' => t('Post new topic link'),
      'help' => t('A link to post in this forum, shown only to viewers who may actually post. Takes the forum from the display\'s forum ID argument.'),
      'area' => array(
        'handler' => 'entity_forum_handler_area_post_link',
      ),
    );
  }

  // Topic type: a plain varchar column would give Views a free-text filter
  // that a site builder has to type machine names into. Swap it for a
  // checkbox list of the site's types — this is the filter a sitedev reaches
  // for when copying the shipped topics view to list one kind of topic.
  if (isset($data['entity_forum_topic']['type'])) {
    $data['entity_forum_topic']['type']['title'] = t('Topic type');
    $data['entity_forum_topic']['type']['help'] = t('The topic type (bundle), e.g. a classified ad.');
    $data['entity_forum_topic']['type']['filter']['handler'] = 'views_handler_filter_in_operator';
    $data['entity_forum_topic']['type']['filter']['options callback'] = 'entity_forum_topic_type_labels';
  }
  // Replies share the topic types as their bundles, so the same filter
  // works — "replies in Classified topics" without a relationship.
  if (isset($data['entity_forum_reply']['type'])) {
    $data['entity_forum_reply']['type']['title'] = t('Reply type');
    $data['entity_forum_reply']['type']['help'] = t("The reply type (bundle), taken from the reply's topic.");
    $data['entity_forum_reply']['type']['filter']['handler'] = 'views_handler_filter_in_operator';
    $data['entity_forum_reply']['type']['filter']['options callback'] = 'entity_forum_topic_type_labels';
  }

  // Aggregate count fields on the forum base table, so a forums-list View
  // can show per-forum totals (rolled up to include sub-forums) without
  // any per-row count queries — they all read the cached counts map from
  // entity_forum_forum_counts(). See entity_forum_handler_field_forum_count.
  if (isset($data['entity_forum_forum'])) {
    $data['entity_forum_forum']['topic_count'] = array(
      'title' => t('Topic count'),
      'help' => t('Published topics in this forum and its sub-forums.'),
      'field' => array(
        'handler' => 'entity_forum_handler_field_forum_count',
        'real field' => 'forum_id',
        'count key' => 'topic_count',
        'click sortable' => FALSE,
      ),
    );
    $data['entity_forum_forum']['post_count'] = array(
      'title' => t('Post count'),
      'help' => t('Topics plus published replies in this forum and its sub-forums (bbPress "Posts").'),
      'field' => array(
        'handler' => 'entity_forum_handler_field_forum_count',
        'real field' => 'forum_id',
        'count key' => 'post_count',
        'click sortable' => FALSE,
      ),
    );
    $data['entity_forum_forum']['reply_count'] = array(
      'title' => t('Reply count'),
      'help' => t('Published replies in this forum and its sub-forums.'),
      'field' => array(
        'handler' => 'entity_forum_handler_field_forum_count',
        'real field' => 'forum_id',
        'count key' => 'reply_count',
        'click sortable' => FALSE,
      ),
    );
    $data['entity_forum_forum']['forum_last_active'] = array(
      'title' => t('Last activity'),
      'help' => t('Newest activity time in this forum or its sub-forums.'),
      'field' => array(
        'handler' => 'entity_forum_handler_field_forum_count',
        'real field' => 'forum_id',
        'count key' => 'last_active_time',
        'is date' => TRUE,
        'click sortable' => FALSE,
      ),
    );
  }
}

/**
 * Returns the IDs of every private forum.
 *
 * Deliberately NOT cached in the cache bin like entity_forum_forum_counts():
 * this list gates access, and a stale entry would leak content. Forums are a
 * handful of rows, so a per-request static over one small query is cheap
 * enough and has no invalidation point to get wrong.
 *
 * @return array
 *   Forum IDs of forums with private visibility, as integers.
 */
function entity_forum_private_forum_ids() {
  $ids = &backdrop_static(__FUNCTION__);
  if (!isset($ids)) {
    $ids = array_map('intval', db_query("SELECT forum_id FROM {entity_forum_forum} WHERE visibility = 'private'")->fetchCol());
  }
  return $ids;
}

/**
 * Implements hook_views_query_alter().
 *
 * Applies the forum visibility rules to every View on ANY of the module's
 * base tables — the shipped views and any view a sitedev builds — so that
 * building or copying one can never widen who sees what. The page callbacks
 * gate the same content, but a view does not go through them.
 *
 * Private forums: the forums themselves, and the topics and replies in them,
 * are removed for viewers without 'view private entity forum'. This rule has
 * NO opt-out — a view is not a safe place to make an exception to an access
 * gate.
 *
 * Listing (topics): only normally listed topics appear, plus admin_only
 * topics when the viewer is a moderator. Unlisted topics (e.g.
 * node-attached comment threads) stay out of all topic lists. A view that
 * defines its own 'listing' filter is left alone — that is the opt-out for
 * special-purpose views such as moderation queues.
 *
 * Listing (replies): only replies of admin_only topics are removed, and
 * only for non-moderators. Deliberately narrower than the topic rule —
 * admin_only is a confidentiality state (the topic page 403s for
 * non-moderators), whereas unlisted only means "not in topic lists" and
 * its topic page is public by design, so hiding unlisted topics' replies
 * would serve no one and would strip node-attached discussions out of
 * reply listings.
 */
function entity_forum_views_query_alter(&$view, &$query) {
  $base = $view->base_table;
  if ($base !== 'entity_forum_forum' && $base !== 'entity_forum_topic' && $base !== 'entity_forum_reply') {
    return;
  }

  $may_see_private = user_access('view private entity forum') || user_access('administer entity forum');

  // A view listing the FORUMS themselves. Filtered on the forum's own
  // visibility — matching entity_forum_forums_page(), which hides a private
  // forum but not its public children.
  if ($base === 'entity_forum_forum') {
    if (!$may_see_private) {
      $query->add_where(0, 'entity_forum_forum.visibility', 'private', '<>');
    }
    // The listing rules below are about topics; nothing else applies here.
    return;
  }

  // Private forums: applied first, and never opted out of. Both base tables
  // carry forum_id, so this needs no join.
  if (!$may_see_private) {
    if ($private = entity_forum_private_forum_ids()) {
      $query->add_where(0, $base . '.forum_id', $private, 'NOT IN');
    }
  }

  if (isset($view->filter['listing'])) {
    return;
  }

  if ($base === 'entity_forum_topic') {
    $allowed = array(ENTITY_FORUM_LISTING_NORMAL);
    if (entity_forum_user_is_moderator()) {
      $allowed[] = ENTITY_FORUM_LISTING_ADMIN_ONLY;
    }
    $query->add_where(0, 'entity_forum_topic.listing', $allowed, 'IN');
  }
  elseif (!entity_forum_user_is_moderator()) {
    // Listing state lives on the topic, so replies need a subquery. The
    // excluded set (held topics) is small; matching on it rather than on
    // the allowed set keeps the IN list short.
    $held = db_select('entity_forum_topic', 'eft_listing');
    $held->fields('eft_listing', array('topic_id'));
    $held->condition('eft_listing.listing', ENTITY_FORUM_LISTING_ADMIN_ONLY);
    $query->add_where(0, 'entity_forum_reply.topic_id', $held, 'NOT IN');
  }
}

/**
 * Implements hook_field_extra_fields().
 *
 * Puts the built-in properties a sitedev actually arranges — titles and
 * bodies — into Field UI beside the attached fields, so a field can be
 * ordered relative to them. Without this the built-ins carry no weight at
 * all, and the moment ANY field has one, element_children() sorts every
 * sibling through an unstable sort: give a classified's price a low weight
 * and it appears above the title, with the title and body then landing in
 * arbitrary order. Weighting them all is what makes the form deterministic.
 *
 * Field UI offers no Delete for extra fields, which is exactly right: these
 * are columns, not fields, and a post cannot exist without them.
 *
 * Deliberately listed: only what a sitedev LAYS OUT. Status, weight,
 * visibility, sticky and the rest are settings they toggle, not content, and
 * would only make the screen noisier.
 *
 * Deliberately 'form' only, no 'display': the posts are rendered by
 * _entity_forum_render_post() and the forum listings, which do not consult
 * the display settings — declaring a display context we do not honour would
 * put controls in the UI that silently do nothing.
 *
 * NOTE the limit of this hook: extra fields have no instance edit form, so
 * they cannot carry widget settings — a widget-configuring module (e.g.
 * acuity_text_formatter, which alters field_ui_field_edit_form) cannot
 * attach to them. Only real fields can. See README.
 */
function entity_forum_field_extra_fields() {
  $extra = array();

  $extra['entity_forum_forum']['entity_forum_forum']['form'] = array(
    'title' => array(
      'label' => t('Title'),
      'description' => t('The forum title.'),
      'weight' => -5,
    ),
    'description' => array(
      'label' => t('Description'),
      'description' => t('The forum description, shown in listings and at the top of the forum.'),
      'weight' => -4,
    ),
  );

  // Topics and replies are bundleable, so every topic type gets its own set
  // — a Classified's price can sit above its body without moving anything on
  // an ordinary topic.
  foreach (array_keys(entity_forum_topic_types()) as $machine_name) {
    $extra['entity_forum_topic'][$machine_name]['form'] = array(
      'title' => array(
        'label' => t('Title'),
        'description' => t('The topic title.'),
        'weight' => -5,
      ),
      'content' => array(
        'label' => t('Content'),
        'description' => t('The body of the opening post.'),
        'weight' => -4,
      ),
    );
    $extra['entity_forum_reply'][$machine_name]['form'] = array(
      'content' => array(
        'label' => t('Reply'),
        'description' => t('The body of the reply.'),
        'weight' => -5,
      ),
    );
  }

  return $extra;
}

/**
 * Applies Field UI's extra-field weights to a form.
 *
 * hook_field_extra_fields() only makes the built-in properties APPEAR on the
 * Manage fields screen; the weights it stores there do nothing until a form
 * reads them back — which is this. Call after field_attach_form(), so the
 * built-ins and the real widgets are weighted from the same source.
 *
 * @param array $form
 *   The form, altered by reference.
 * @param string $entity_type
 *   The entity type.
 * @param string $bundle
 *   The bundle.
 */
function entity_forum_apply_extra_field_weights(array &$form, $entity_type, $bundle) {
  foreach (field_info_extra_fields($entity_type, $bundle, 'form') as $name => $extra_field) {
    if (isset($form[$name]) && isset($extra_field['weight'])) {
      $form[$name]['#weight'] = $extra_field['weight'];
    }
  }
}

/**
 * Implements hook_config_info().
 */
function entity_forum_config_info() {
  return array(
    'entity_forum.settings' => array(
      'label' => t('Entity Forum settings'),
      'group' => t('Configuration'),
    ),
    'entity_forum.type' => array(
      'name_key' => 'type',
      'label_key' => 'label',
      'group' => t('Entity Forum topic types'),
    ),
  );
}

/**
 * Returns every topic type (bundle), keyed by machine name.
 *
 * Topic types are plain config (entity_forum.type.*), like core content
 * types: a site defines its own types and attaches fields per type through
 * Field UI, with no forum code involved.
 *
 * The default type is synthesised when its config is missing, because a
 * fieldable entity type must never report zero bundles — Field API, every
 * topic form and entity_extract_ids() all need the bundle to resolve, and a
 * site with no types at all would fatal rather than merely look empty.
 *
 * @return array
 *   Topic type objects keyed by machine name, each with type, label and
 *   description properties, sorted by label.
 */
function entity_forum_topic_types() {
  $types = &backdrop_static(__FUNCTION__);
  if (isset($types)) {
    return $types;
  }

  $types = array();
  foreach (config_get_names_with_prefix('entity_forum.type.') as $config_name) {
    $config = config($config_name);
    $machine_name = (string) $config->get('type');
    if ($machine_name === '') {
      continue;
    }
    $types[$machine_name] = (object) array(
      'type' => $machine_name,
      'label' => (string) $config->get('label'),
      'description' => (string) $config->get('description'),
    );
  }

  if (!isset($types[ENTITY_FORUM_TOPIC_TYPE_DEFAULT])) {
    $types[ENTITY_FORUM_TOPIC_TYPE_DEFAULT] = (object) array(
      'type' => ENTITY_FORUM_TOPIC_TYPE_DEFAULT,
      'label' => t('Topic'),
      'description' => '',
    );
  }

  uasort($types, function ($a, $b) {
    return strnatcasecmp($a->label, $b->label);
  });

  return $types;
}

/**
 * Returns topic type labels keyed by machine name.
 *
 * The options callback behind the Views "Topic type" filter, and handy
 * anywhere a select or checkboxes of types is needed.
 *
 * @return array
 *   Type labels keyed by machine name.
 */
function entity_forum_topic_type_labels() {
  $labels = array();
  foreach (entity_forum_topic_types() as $machine_name => $topic_type) {
    $labels[$machine_name] = $topic_type->label;
  }
  return $labels;
}

/**
 * Title callback: a topic type's label.
 *
 * Lives here, not in entity_forum.admin.inc, and must stay here: a title
 * callback is invoked while rendering CHILD paths too — Field UI's
 * .../fields and .../display tabs are separate menu items carrying their own
 * 'file', so this menu item's file is never loaded for them and the callback
 * would not exist. Core keeps node_type_page_title() in node.module for the
 * same reason.
 *
 * @param object $topic_type
 *   The topic type, loaded by entity_forum_topic_type_load().
 *
 * @return string
 *   The type label.
 */
function entity_forum_topic_type_title($topic_type) {
  return $topic_type->label;
}

/**
 * Menu loader: loads a topic type from its machine name.
 *
 * Also the bundle loader Field UI uses — field_ui_menu_load() runs
 * field_extract_bundle() over whatever this returns, which reads the entity's
 * bundle key ('type') off the object, so the return value must carry it.
 *
 * @param string $name
 *   The type machine name, hyphenated as it appears in a path.
 *
 * @return object|false
 *   The topic type object, or FALSE when no such type exists.
 */
function entity_forum_topic_type_load($name) {
  $types = entity_forum_topic_types();
  $machine_name = strtr($name, '-', '_');
  return isset($types[$machine_name]) ? $types[$machine_name] : FALSE;
}

/**
 * Saves a topic type to config.
 *
 * @param object $type
 *   A topic type object with type, label and (optionally) description.
 */
function entity_forum_topic_type_save($type) {
  $config = config('entity_forum.type.' . $type->type);
  $config->set('type', $type->type);
  $config->set('label', $type->label);
  $config->set('description', isset($type->description) ? (string) $type->description : '');
  $config->save();
  entity_forum_topic_types_reset();
}

/**
 * Deletes a topic type's config.
 *
 * Callers are responsible for refusing to delete a type that still has
 * topics, or the default type — see entity_forum_topic_type_delete_form().
 *
 * @param string $machine_name
 *   The type to delete.
 */
function entity_forum_topic_type_delete($machine_name) {
  config('entity_forum.type.' . $machine_name)->delete();
  entity_forum_topic_types_reset();
}

/**
 * Counts the topics using a topic type.
 *
 * @param string $machine_name
 *   The type to count.
 *
 * @return int
 *   Number of topics on that type.
 */
function entity_forum_topic_type_usage($machine_name) {
  return (int) db_query('SELECT COUNT(*) FROM {entity_forum_topic} WHERE type = :type', array(
    ':type' => $machine_name,
  ))->fetchField();
}

/**
 * Returns the topic type posted in a forum.
 *
 * The type is a property of the FORUM, set when the forum is created: a
 * classifieds forum holds classified ads, and posting never asks. A forum
 * that needs a different kind of topic gets a sub-forum. This is what
 * replaced scoping fields to particular forums — the fields belong to the
 * type, and the forum picks the type, so Field API does the rest.
 *
 * Falls back to the default type when the forum names a type that has since
 * been deleted, rather than leave a forum nothing can be posted in.
 *
 * @param EntityForumForum $forum
 *   The forum to inspect.
 *
 * @return object
 *   The topic type object.
 */
function entity_forum_forum_topic_type($forum) {
  $machine_name = isset($forum->topic_type) ? (string) $forum->topic_type : '';

  // Empty is a DELIBERATE choice — "- None -" on the forum form — meaning a
  // container forum that holds only sub-forums. Distinct from the case
  // below, and the two must never be collapsed: same column, opposite
  // outcomes.
  if ($machine_name === ENTITY_FORUM_FORUM_TOPIC_TYPE_NONE) {
    return FALSE;
  }

  $types = entity_forum_topic_types();
  if (isset($types[$machine_name])) {
    return $types[$machine_name];
  }

  // Names a type that has since been deleted. Fall back to the default
  // rather than treat it as a container: deleting a type must not silently
  // stop people posting where they always could.
  return $types[ENTITY_FORUM_TOPIC_TYPE_DEFAULT];
}

/**
 * Whether a forum only contains sub-forums (no topics can be posted).
 *
 * @param EntityForumForum $forum
 *   The forum to check.
 *
 * @return bool
 *   TRUE when the forum is a container.
 */
function entity_forum_forum_is_container($forum) {
  return entity_forum_forum_topic_type($forum) === FALSE;
}

/**
 * Returns the view display that renders a forum's topic list.
 *
 * The forum page used to embed one hardcoded view display for every forum on
 * every site. Choosing it per forum is what lets a sitedev's copy of the
 * topics view actually be USED — a classifieds forum rendering as an ad grid
 * while General stays a topic table — instead of only ever living on a
 * standalone page.
 *
 * Falls back to the shipped default when the forum names a view or display
 * that has since been deleted, on the same principle as
 * entity_forum_forum_topic_type(): deleting config must not leave a forum
 * with no topic list at all. Unlike topic_type, empty is NOT a distinct
 * outcome here — a forum that takes no topics is already a container, and its
 * list is not rendered either way.
 *
 * @param EntityForumForum $forum
 *   The forum to inspect.
 *
 * @return array
 *   Keys 'view' (view name) and 'display' (display ID).
 */
function entity_forum_forum_topic_list_view($forum) {
  $stored = isset($forum->topic_view) ? (string) $forum->topic_view : '';
  $candidates = array($stored, ENTITY_FORUM_TOPIC_LIST_VIEW_DEFAULT);

  foreach ($candidates as $candidate) {
    if ($candidate === '' || strpos($candidate, ':') === FALSE) {
      continue;
    }
    list($name, $display_id) = explode(':', $candidate, 2);
    $view = views_get_view($name);
    if ($view && isset($view->display[$display_id])) {
      $view->destroy();
      return array('view' => $name, 'display' => $display_id);
    }
  }

  // The default itself is missing — the sitedev deleted the shipped view.
  // Return it anyway: views_embed_view() renders nothing for an unknown view,
  // which is the honest outcome, and inventing a substitute here would only
  // hide what they did.
  list($name, $display_id) = explode(':', ENTITY_FORUM_TOPIC_LIST_VIEW_DEFAULT, 2);
  return array('view' => $name, 'display' => $display_id);
}

/**
 * Returns the view displays that can render a forum's topic list.
 *
 * Offers only displays that can actually do the job: built on the topic base
 * table, and carrying a forum ID argument — the forum page embeds the display
 * with the forum's ID, and a display with nowhere to receive it would show
 * every forum's topics in every forum.
 *
 * Matched on the argument's FIELD rather than its key, because a second
 * argument on the same column is keyed forum_id_1 (the same reason
 * entity_forum_handler_area_post_link does it that way).
 *
 * @return array
 *   Options for a select, keyed "view_name:display_id".
 */
function entity_forum_topic_list_view_options() {
  $options = array();

  foreach (views_get_all_views() as $name => $stub) {
    if (!empty($stub->disabled) || $stub->base_table !== 'entity_forum_topic') {
      continue;
    }
    $view = views_get_view($name);
    if (!$view) {
      continue;
    }
    $view_label = $view->human_name ? $view->human_name : $name;

    foreach (array_keys($view->display) as $display_id) {
      $view->set_display($display_id);
      // get_option() on the display handler resolves the display's own
      // arguments or the default display's, per what it overrides — reading
      // display_options directly would miss that.
      $arguments = $view->display_handler->get_option('arguments');
      $has_forum_argument = FALSE;
      foreach ((array) $arguments as $argument) {
        if (isset($argument['field']) && $argument['field'] === 'forum_id') {
          $has_forum_argument = TRUE;
          break;
        }
      }
      if (!$has_forum_argument) {
        continue;
      }
      $display_label = !empty($view->display[$display_id]->display_title)
        ? $view->display[$display_id]->display_title
        : $display_id;
      $options[$name . ':' . $display_id] = $view_label . ': ' . $display_label;
    }
    $view->destroy();
  }

  asort($options);
  return $options;
}

/**
 * Returns the forums using a topic type, keyed by forum ID.
 *
 * Used to narrow the admin topic form's forum select to the forums that
 * actually take the type being added, and to warn before a type is deleted.
 *
 * @param string $machine_name
 *   The topic type.
 *
 * @return array
 *   Forum titles keyed by forum_id.
 */
function entity_forum_forums_of_topic_type($machine_name) {
  return db_query('SELECT forum_id, title FROM {entity_forum_forum} WHERE topic_type = :type ORDER BY weight, title', array(
    ':type' => $machine_name,
  ))->fetchAllKeyed();
}

/**
 * Clears the caches that depend on the set of topic types.
 *
 * The types drive hook_entity_info()'s bundle list, which in turn drives the
 * Field UI menu items, so both the entity info cache and the menu have to be
 * rebuilt whenever a type is added, renamed or removed.
 */
function entity_forum_topic_types_reset() {
  backdrop_static_reset('entity_forum_topic_types');
  entity_info_cache_clear();
  field_info_cache_clear();
  menu_rebuild();
}

/**
 * Implements hook_permission().
 */
function entity_forum_permission() {
  return array(
    'administer entity forum' => array(
      'title' => t('Administer Entity Forum'),
      'description' => t('Create, edit, and delete forums.'),
    ),
    'view private entity forum' => array(
      'title' => t('View private Entity Forums'),
      'description' => t('View forums marked as private, and their topics.'),
    ),
    'create entity forum topic' => array(
      'title' => t('Create Entity Forum topics'),
      'description' => t('Post new topics, and edit or delete the user\'s own topics.'),
    ),
    'administer entity forum topic' => array(
      'title' => t('Administer Entity Forum topics'),
      'description' => t('Edit and delete <em>any</em> topic (moderator). Not needed to edit one\'s own topics.'),
    ),
    'create entity forum reply' => array(
      'title' => t('Create Entity Forum replies'),
      'description' => t('Post replies, and edit or delete the user\'s own replies.'),
    ),
    'administer entity forum reply' => array(
      'title' => t('Administer Entity Forum replies'),
      'description' => t('Edit and delete <em>any</em> reply (moderator). Not needed to edit one\'s own replies.'),
    ),
    'moderate entity forum' => array(
      'title' => t('Moderate Entity Forum'),
      'description' => t('See the moderation panels and queue, approve posts held for review, view moderator-only topics, and set member posting statuses. Combine with the administer topic/reply permissions for full moderator rights.'),
    ),
  );
}

/**
 * Implements hook_menu().
 */
function entity_forum_menu() {
  $items = array();

  // Frontend.
  $items['forums'] = array(
    'title' => 'Forums',
    'page callback' => 'entity_forum_forums_page',
    'access arguments' => array('access content'),
    'file' => 'entity_forum.pages.inc',
  );
  $items['forum/%entity_forum_forum'] = array(
    'title callback' => 'entity_label',
    'title arguments' => array('entity_forum_forum', 1),
    'page callback' => 'entity_forum_forum_page',
    'page arguments' => array(1),
    'access callback' => 'entity_forum_forum_access',
    'access arguments' => array('view', 1),
    'file' => 'entity_forum.pages.inc',
  );
  // Posting. The topic type comes from the forum, so there is nothing to
  // choose and no type in the URL: this path is simply the form, exactly as
  // it was before types existed.
  $items['forum/%entity_forum_forum/new-topic'] = array(
    'title' => 'New topic',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_topic_frontend_form', 1),
    'access callback' => 'entity_forum_topic_create_access',
    'access arguments' => array(1),
    'file' => 'entity_forum.pages.inc',
  );
  $items['topic/%entity_forum_topic'] = array(
    'title callback' => 'entity_label',
    'title arguments' => array('entity_forum_topic', 1),
    'page callback' => 'entity_forum_topic_page',
    'page arguments' => array(1),
    'access callback' => 'entity_forum_topic_view_access',
    'access arguments' => array(1),
    'file' => 'entity_forum.pages.inc',
  );
  // The reply form as its own page, reached from the per-post "Reply"
  // links. One reply route, one reply form — the fields a site attaches to
  // the reply type are always present on it.
  $items['topic/%entity_forum_topic/reply'] = array(
    'title' => 'Reply',
    'page callback' => 'entity_forum_reply_page',
    'page arguments' => array(1),
    'access callback' => 'entity_forum_reply_create_access',
    'access arguments' => array(1),
    'file' => 'entity_forum.pages.inc',
  );
  // Author self-service close/reopen ("mark as sold") — a token-protected
  // action link, offered only in forums with the author_close setting.
  $items['topic/%entity_forum_topic/toggle-closed'] = array(
    'page callback' => 'entity_forum_topic_toggle_closed',
    'page arguments' => array(1),
    'access callback' => 'entity_forum_topic_author_close_access',
    'access arguments' => array(1),
    'type' => MENU_CALLBACK,
    'file' => 'entity_forum.pages.inc',
  );

  // Autocomplete for attaching a topic to content on the admin topic
  // form ("Title [nid:N]" pattern, node_access-respecting).
  $items['entity-forum/node-autocomplete'] = array(
    'page callback' => 'entity_forum_node_autocomplete',
    'delivery callback' => 'backdrop_json_deliver',
    'access arguments' => array('administer entity forum topic'),
    'type' => MENU_CALLBACK,
    'file' => 'entity_forum.admin.inc',
  );

  // Report form. URL parts: forum-report/{topic|reply}/{id}.
  $items['forum-report/%/%'] = array(
    'title' => 'Report content',
    'page callback' => 'entity_forum_report_page',
    'page arguments' => array(1, 2),
    'access callback' => 'entity_forum_report_access',
    'access arguments' => array(1, 2),
    'file' => 'entity_forum.pages.inc',
  );

  // Moderation queue: posts held for review, with approve/keep-hidden
  // actions. A frontend page (not admin/*) so it can be linked from the
  // moderation panels shown above the forum lists.
  $items['forums/moderation'] = array(
    'title' => 'Forum moderation',
    'page callback' => 'entity_forum_moderation_page',
    'access callback' => 'entity_forum_user_is_moderator',
    'file' => 'entity_forum.pages.inc',
  );
  $items['forums/moderation/approve/%/%'] = array(
    'page callback' => 'entity_forum_moderation_action',
    'page arguments' => array('approve', 3, 4),
    'access callback' => 'entity_forum_user_is_moderator',
    'type' => MENU_CALLBACK,
    'file' => 'entity_forum.pages.inc',
  );
  $items['forums/moderation/hide/%/%'] = array(
    'page callback' => 'entity_forum_moderation_action',
    'page arguments' => array('hide', 3, 4),
    'access callback' => 'entity_forum_user_is_moderator',
    'type' => MENU_CALLBACK,
    'file' => 'entity_forum.pages.inc',
  );
  $items['forums/moderation/resolve/%/%'] = array(
    'page callback' => 'entity_forum_moderation_action',
    'page arguments' => array('resolve', 3, 4),
    'access callback' => 'entity_forum_user_is_moderator',
    'type' => MENU_CALLBACK,
    'file' => 'entity_forum.pages.inc',
  );

  // Account page: the member's forum tab (posting name + their posts).
  $items['user/%user/forum-posts'] = array(
    'title' => 'Forum',
    'page callback' => 'entity_forum_user_posts_page',
    'page arguments' => array(1),
    'access callback' => 'entity_forum_user_posts_access',
    'access arguments' => array(1),
    'type' => MENU_LOCAL_TASK,
    'file' => 'entity_forum.pages.inc',
  );

  // Admin UI: a "Forums" tab on admin/content.
  $items['admin/content/entity-forum'] = array(
    'title' => 'Forums',
    'page callback' => 'entity_forum_admin_forums',
    'access arguments' => array('administer entity forum'),
    'type' => MENU_LOCAL_TASK,
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/content/entity-forum/forums'] = array(
    'title' => 'Forums',
    'type' => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  );
  $items['admin/content/entity-forum/topics'] = array(
    'title' => 'Topics',
    'page callback' => 'entity_forum_admin_topics',
    'access arguments' => array('administer entity forum topic'),
    'type' => MENU_LOCAL_TASK,
    'file' => 'entity_forum.admin.inc',
  );
  // The Replies tab (admin/content/entity-forum/replies) is provided by
  // the forum_replies_admin view's page display (a local task), so site
  // builders can adjust its columns, filters, path and title through the
  // Views UI. See config/views.view.forum_replies_admin.json.
  $items['admin/content/entity-forum/settings'] = array(
    'title' => 'Settings',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_settings_form'),
    'access arguments' => array('administer entity forum'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 10,
    'file' => 'entity_forum.admin.inc',
  );
  // Help tab. Backdrop core has dropped hook_help(), so this is our own menu
  // item + page callback rather than a hook_help() implementation. The page
  // is written as four independently-anchored audience sections (site
  // builders, forum builders, moderators, members) so it can later be split
  // — the moderator and member sections to frontend pages with their own
  // access — without rewriting the content. Gated on the admin permission
  // for now, which is why every section currently lives behind this tab.
  $items['admin/content/entity-forum/help'] = array(
    'title' => 'Help',
    'page callback' => 'entity_forum_help_page',
    'access arguments' => array('administer entity forum'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 20,
    'file' => 'entity_forum.admin.inc',
  );

  // Content-discussion placements: add/edit/delete a single content-type →
  // forum mapping. Keyed on the content type machine name (the node_types
  // config key). These are the "Add placement" workflow behind the table on
  // the settings page, replacing the old one-select-per-type list.
  $items['admin/content/entity-forum/settings/discussions/add'] = array(
    'title' => 'Add content discussion',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_node_discussion_form'),
    'access arguments' => array('administer entity forum'),
    'type' => MENU_CALLBACK,
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/content/entity-forum/settings/discussions/edit/%'] = array(
    'title' => 'Edit content discussion',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_node_discussion_form', 6),
    'access arguments' => array('administer entity forum'),
    'type' => MENU_CALLBACK,
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/content/entity-forum/settings/discussions/delete/%'] = array(
    'title' => 'Delete content discussion',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_node_discussion_delete_form', 6),
    'access arguments' => array('administer entity forum'),
    'type' => MENU_CALLBACK,
    'file' => 'entity_forum.admin.inc',
  );

  // Structure UI: the entity types are fieldable — these bundle admin
  // pages give Field UI somewhere to attach its "Manage fields" and
  // "Manage display" tabs, so sites can add fields (e.g. attachments)
  // through the normal Backdrop UI.
  $items['admin/structure/entity-forum'] = array(
    'title' => 'Forums',
    'description' => 'Manage fields and display for forums, topics and replies.',
    'page callback' => 'entity_forum_structure_page',
    'access arguments' => array('administer entity forum'),
    'file' => 'entity_forum.admin.inc',
  );
  // Forums are the only single-bundle type left: one page. Topics get a
  // type list (below), and replies hang off each topic type's Replies tab.
  $bundle_pages = array(
    'forum' => array('entity_forum_forum', 'Forum'),
  );
  foreach ($bundle_pages as $path_part => $bundle_info) {
    $items['admin/structure/entity-forum/' . $path_part] = array(
      'title' => $bundle_info[1],
      'page callback' => 'entity_forum_structure_bundle_page',
      'page arguments' => array($bundle_info[0]),
      'access arguments' => array('administer entity forum'),
      'file' => 'entity_forum.admin.inc',
    );
  }

  // Topic types: a site defines its own, and Field UI attaches its tabs to
  // each type's edit page (see the bundle 'admin' paths in
  // entity_forum_entity_info()).
  $items['admin/structure/entity-forum/topic-types'] = array(
    'title' => 'Topic types',
    'description' => 'Manage topic types and their fields.',
    'page callback' => 'entity_forum_topic_types_page',
    'access arguments' => array('administer entity forum'),
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/structure/entity-forum/topic-types/add'] = array(
    'title' => 'Add topic type',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_topic_type_form'),
    'access arguments' => array('administer entity forum'),
    'type' => MENU_LOCAL_ACTION,
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/structure/entity-forum/topic-types/%entity_forum_topic_type'] = array(
    'title callback' => 'entity_forum_topic_type_title',
    'title arguments' => array(4),
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_topic_type_form', 4),
    'access arguments' => array('administer entity forum'),
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/structure/entity-forum/topic-types/%entity_forum_topic_type/edit'] = array(
    'title' => 'Edit',
    'type' => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  );
  // Replies in this type of topic. A reply's bundle is its topic's type, so
  // its fields belong here rather than in a type system of their own; Field
  // UI hangs its tabs off this path (see the reply bundles in
  // entity_forum_entity_info()).
  $items['admin/structure/entity-forum/topic-types/%entity_forum_topic_type/replies'] = array(
    'title' => 'Replies',
    'page callback' => 'entity_forum_topic_type_replies_page',
    'page arguments' => array(4),
    'access arguments' => array('administer entity forum'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 0,
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/structure/entity-forum/topic-types/%entity_forum_topic_type/delete'] = array(
    'title' => 'Delete',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_topic_type_delete_form', 4),
    'access arguments' => array('administer entity forum'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 10,
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/content/entity-forum/forums/add'] = array(
    'title' => 'Add forum',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_forum_form'),
    'access arguments' => array('administer entity forum'),
    'type' => MENU_LOCAL_ACTION,
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/content/entity-forum/topics/add'] = array(
    'title' => 'Add topic',
    'page callback' => 'entity_forum_admin_topic_add_page',
    'access arguments' => array('administer entity forum topic'),
    'type' => MENU_LOCAL_ACTION,
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/content/entity-forum/topics/add/%entity_forum_topic_type'] = array(
    'title' => 'Add topic',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_topic_form', NULL, 5),
    'access arguments' => array('administer entity forum topic'),
    'file' => 'entity_forum.admin.inc',
  );

  // Entity edit/delete forms. Access checks allow both administrators and
  // (for topics/replies) the original author.
  $items['admin/content/entity-forum/forum/%entity_forum_forum/edit'] = array(
    'title' => 'Edit forum',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_forum_form', 4),
    'access callback' => 'entity_forum_forum_access',
    'access arguments' => array('update', 4),
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/content/entity-forum/forum/%entity_forum_forum/delete'] = array(
    'title' => 'Delete forum',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_forum_delete_form', 4),
    'access callback' => 'entity_forum_forum_access',
    'access arguments' => array('delete', 4),
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/content/entity-forum/topic/%entity_forum_topic/edit'] = array(
    'title' => 'Edit topic',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_topic_form', 4),
    'access callback' => 'entity_forum_topic_access',
    'access arguments' => array('update', 4),
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/content/entity-forum/topic/%entity_forum_topic/delete'] = array(
    'title' => 'Delete topic',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_topic_delete_form', 4),
    'access callback' => 'entity_forum_topic_access',
    'access arguments' => array('delete', 4),
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/content/entity-forum/reply/%entity_forum_reply/edit'] = array(
    'title' => 'Edit reply',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_reply_form', 4),
    'access callback' => 'entity_forum_reply_access',
    'access arguments' => array('update', 4),
    'file' => 'entity_forum.admin.inc',
  );
  $items['admin/content/entity-forum/reply/%entity_forum_reply/delete'] = array(
    'title' => 'Delete reply',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('entity_forum_reply_delete_form', 4),
    'access callback' => 'entity_forum_reply_access',
    'access arguments' => array('delete', 4),
    'file' => 'entity_forum.admin.inc',
  );

  return $items;
}

/**
 * Menu wildcard loader for %entity_forum_forum.
 *
 * @param int $forum_id
 *   The forum ID from the URL.
 *
 * @return EntityForumForum|false
 *   The forum entity, or FALSE to trigger a 404.
 */
function entity_forum_forum_load($forum_id) {
  $forum = entity_load('entity_forum_forum', $forum_id);
  return $forum ? $forum : FALSE;
}

/**
 * Menu wildcard loader for %entity_forum_topic.
 *
 * @param int $topic_id
 *   The topic ID from the URL.
 *
 * @return EntityForumTopic|false
 *   The topic entity, or FALSE to trigger a 404.
 */
function entity_forum_topic_load($topic_id) {
  $topic = entity_load('entity_forum_topic', $topic_id);
  return $topic ? $topic : FALSE;
}

/**
 * Menu wildcard loader for %entity_forum_reply.
 *
 * @param int $reply_id
 *   The reply ID from the URL.
 *
 * @return EntityForumReply|false
 *   The reply entity, or FALSE to trigger a 404.
 */
function entity_forum_reply_load($reply_id) {
  $reply = entity_load('entity_forum_reply', $reply_id);
  return $reply ? $reply : FALSE;
}

/**
 * Entity URI callback for forums.
 *
 * @param EntityForumForum $forum
 *   The forum entity.
 *
 * @return array
 *   URI array as expected by entity_uri().
 */
function entity_forum_forum_uri($forum) {
  return $forum->uri();
}

/**
 * Entity URI callback for topics.
 *
 * @param EntityForumTopic $topic
 *   The topic entity.
 *
 * @return array
 *   URI array as expected by entity_uri().
 */
function entity_forum_topic_uri($topic) {
  return $topic->uri();
}

/**
 * Entity URI callback for replies.
 *
 * @param EntityForumReply $reply
 *   The reply entity.
 *
 * @return array
 *   URI array as expected by entity_uri().
 */
function entity_forum_reply_uri($reply) {
  return $reply->uri();
}

/**
 * Access callback for forum entities.
 *
 * Signature follows entity_plus_access(): ($op, $entity, $account, $type).
 *
 * @param string $op
 *   One of 'create', 'view', 'update', 'delete'.
 * @param EntityForumForum|null $forum
 *   The forum, or NULL for the 'create' operation.
 * @param object|null $account
 *   The user to check; defaults to the current user.
 *
 * @return bool
 *   Whether access is granted.
 */
function entity_forum_forum_access($op, $forum = NULL, $account = NULL, $entity_type = NULL) {
  switch ($op) {
    case 'view':
      if ($forum && $forum->visibility === 'private') {
        return user_access('view private entity forum', $account) || user_access('administer entity forum', $account);
      }
      return TRUE;

    case 'create':
    case 'update':
    case 'delete':
      return user_access('administer entity forum', $account);
  }
  return FALSE;
}

/**
 * Returns the forum_id a topic or reply belongs to.
 *
 * @param string $type
 *   entity_forum_topic or entity_forum_reply.
 * @param int $id
 *   The entity ID.
 *
 * @return int
 *   The owning forum_id, or 0.
 */
function entity_forum_post_forum_id($type, $id) {
  if ($type === 'entity_forum_topic') {
    return (int) db_query('SELECT forum_id FROM {entity_forum_topic} WHERE topic_id = :id', array(':id' => $id))->fetchField();
  }
  if ($type === 'entity_forum_reply') {
    return (int) db_query('SELECT forum_id FROM {entity_forum_reply} WHERE reply_id = :id', array(':id' => $id))->fetchField();
  }
  return 0;
}

/**
 * Returns the distinct forum IDs a managed file is attached to.
 *
 * Resolves {file_usage} rows pointing at a topic or reply, then that post's
 * forum.
 *
 * **Deliberately keyed on the usage's TYPE, never on its module.** Files
 * reach a post through Field API, and core records those usages as module
 * 'file' — so a module filter would make this return nothing for every field
 * file, and entity_forum_file_download() would abstain on precisely the files
 * it exists to protect. {file_usage} is already the generic index of "which
 * files does this post use"; who wrote the row is not this module's business.
 * Same rule as the Views query alter: the access check follows the DATA, not
 * the code path that happened to create it.
 *
 * Rows for other entity types (forum pictures are usage rows on 'user') are
 * ignored — entity_forum_post_forum_id() returns 0 for anything that is not a
 * forum post.
 *
 * @param int $fid
 *   The managed file ID.
 *
 * @return array
 *   Forum IDs the file is used in (empty if the file is not used by a forum
 *   post at all).
 */
function entity_forum_file_forums($fid) {
  $forums = array();
  $usages = db_query("SELECT type, id FROM {file_usage} WHERE fid = :fid AND type IN ('entity_forum_topic', 'entity_forum_reply')", array(':fid' => $fid))->fetchAll();
  foreach ($usages as $u) {
    $forum_id = entity_forum_post_forum_id($u->type, $u->id);
    if ($forum_id) {
      $forums[$forum_id] = $forum_id;
    }
  }
  return array_values($forums);
}

/**
 * Whether a forum attachment must live in the private:// scheme.
 *
 * A file is private when ANY forum it is attached to is private — the
 * most restrictive using forum wins.
 *
 * @param int $fid
 *   The managed file ID.
 *
 * @return bool
 *   TRUE if the file should be stored privately.
 */
function entity_forum_file_should_be_private($fid) {
  foreach (entity_forum_file_forums($fid) as $forum_id) {
    if (db_query('SELECT visibility FROM {entity_forum_forum} WHERE forum_id = :id', array(':id' => $forum_id))->fetchField() === 'private') {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Implements hook_file_download().
 *
 * Access control for forum attachments stored privately: a private:// file
 * used by a forum post is served only when the current user may view at
 * least one of the forums it belongs to (public forums are viewable by
 * everyone; private forums require 'view private entity forum'). Files this
 * module does not manage are ignored (return NULL). Public:// attachments
 * never reach this hook — they are served directly by the web server.
 *
 * @param string $uri
 *   The URI of the file being downloaded.
 *
 * @return array|int|null
 *   Content headers to grant access, -1 to deny, or NULL to abstain.
 */
function entity_forum_file_download($uri) {
  $fid = db_query('SELECT fid FROM {file_managed} WHERE uri = :uri', array(':uri' => $uri))->fetchField();
  if (!$fid) {
    return NULL;
  }
  $forums = entity_forum_file_forums($fid);
  if (!$forums) {
    // Not a forum attachment — let other modules decide.
    return NULL;
  }
  foreach ($forums as $forum_id) {
    $forum = entity_forum_forum_load($forum_id);
    if ($forum && entity_forum_forum_access('view', $forum)) {
      return file_get_content_headers(file_load($fid));
    }
  }
  return -1;
}

/**
 * Moves a forum attachment into the storage scheme its forum requires.
 *
 * Private-forum attachments belong in private:// (gated by
 * entity_forum_file_download()); everything else stays public://. The file
 * keeps its path within the scheme, and stale image derivatives at the old
 * location are flushed. Safe and idempotent — a no-op when already correct.
 *
 * @param object $file
 *   A managed file object.
 *
 * @return bool
 *   TRUE if the file was moved.
 */
function entity_forum_rescheme_file($file) {
  $target_scheme = entity_forum_file_should_be_private($file->fid) ? 'private' : 'public';
  if (file_uri_scheme($file->uri) === $target_scheme) {
    return FALSE;
  }
  // A private scheme must be configured before anything can be secured.
  if ($target_scheme === 'private' && !file_stream_wrapper_valid_scheme('private')) {
    return FALSE;
  }
  $old_uri = $file->uri;
  $destination = $target_scheme . '://' . file_uri_target($old_uri);
  $dir = backdrop_dirname($destination);
  if (!file_prepare_directory($dir, FILE_CREATE_DIRECTORY)) {
    return FALSE;
  }
  if (file_move($file, $destination, FILE_EXISTS_REPLACE)) {
    image_path_flush($old_uri);
    return TRUE;
  }
  return FALSE;
}

/**
 * Re-schemes the field files used by a forum's posts.
 *
 * Called when a forum's visibility changes so its posts' files move into
 * (or out of) private:// to match. Returns the number of files moved.
 *
 * @param int $forum_id
 *   The forum whose files should be re-checked.
 *
 * @return int
 *   Count of files moved.
 */
function entity_forum_rescheme_forum_files($forum_id) {
  $fids = db_query("SELECT DISTINCT u.fid
    FROM {file_usage} u
    LEFT JOIN {entity_forum_topic} t ON u.type = 'entity_forum_topic' AND t.topic_id = u.id
    LEFT JOIN {entity_forum_reply} r ON u.type = 'entity_forum_reply' AND r.reply_id = u.id
    WHERE u.module = 'file' AND u.type IN ('entity_forum_topic', 'entity_forum_reply')
      AND COALESCE(t.forum_id, r.forum_id) = :forum_id", array(':forum_id' => $forum_id))->fetchCol();
  $moved = 0;
  foreach ($fids as $fid) {
    $file = file_load($fid);
    if ($file && entity_forum_rescheme_file($file)) {
      $moved++;
    }
  }
  return $moved;
}

/**
 * Re-schemes the field files a single forum post uses.
 *
 * Called whenever a topic or reply is saved, because **a file field decides
 * where it uploads, and it decides once for the whole field.** A field
 * attached to a topic type used in both a public and a private forum has one
 * upload destination for both, so a member posting a photo to a private forum
 * lands it in public:// — where the web server serves it directly and
 * entity_forum_file_download() is never consulted. Privacy is a property of
 * the FORUM, not of the field, so the post's own save is the only point that
 * can put the file in the right scheme.
 *
 * **Only FIELD files (module 'file') are moved, and that distinction is
 * load-bearing.** A field file is rendered by its formatter, which resolves
 * the URI at render time, so moving it is invisible. A file referenced from
 * inside post CONTENT — an inline image, whose URL is baked into the body text
 * as characters — cannot be moved without breaking the post, and no amount of
 * re-scheming will fix the text. Hence entity_forum's standing limitation:
 * inline images stay public, and the gate covers the Attachments only. This
 * rule was learned the hard way: a previous pass keyed on the module that
 * WROTE the usage row rather than on whether the reference was baked, and
 * duly moved 118 inline images into private://, breaking every URL that
 * pointed at them.
 *
 * Contrast entity_forum_file_forums(), which deliberately ignores the module:
 * for the ACCESS question, any reference counts. For the MOVE question, only
 * render-time references may be touched.
 *
 * A no-op when the file is already correctly placed, so the common case costs
 * one query and no I/O.
 *
 * @param string $entity_type
 *   entity_forum_topic or entity_forum_reply.
 * @param int $id
 *   The post's entity ID.
 *
 * @return int
 *   Count of files moved.
 */
function entity_forum_rescheme_post_files($entity_type, $id) {
  $fids = db_query("SELECT fid FROM {file_usage} WHERE module = 'file' AND type = :type AND id = :id", array(
    ':type' => $entity_type,
    ':id' => $id,
  ))->fetchCol();
  $moved = 0;
  foreach ($fids as $fid) {
    $file = file_load($fid);
    if ($file && entity_forum_rescheme_file($file)) {
      $moved++;
    }
  }
  return $moved;
}

/**
 * Access callback for topic entities.
 *
 * @param string $op
 *   One of 'create', 'view', 'update', 'delete'.
 * @param EntityForumTopic|null $topic
 *   The topic, or NULL for the 'create' operation.
 * @param object|null $account
 *   The user to check; defaults to the current user.
 *
 * @return bool
 *   Whether access is granted.
 */
function entity_forum_topic_access($op, $topic = NULL, $account = NULL, $entity_type = NULL) {
  if (!isset($account)) {
    $account = $GLOBALS['user'];
  }
  switch ($op) {
    case 'create':
      return user_access('create entity forum topic', $account);

    case 'view':
      // Admin-only topics (held for moderation) are visible to moderators
      // alone; normal and unlisted topics are viewable by anyone who can
      // reach them (the forum-level check runs separately).
      if ($topic && isset($topic->listing) && $topic->listing === ENTITY_FORUM_LISTING_ADMIN_ONLY) {
        return entity_forum_user_is_moderator($account);
      }
      return TRUE;

    case 'update':
    case 'delete':
      // The own-post check requires a logged-in account: uid 0 posts are
      // orphans/imports, never editable by anonymous visitors.
      return user_access('administer entity forum topic', $account)
        || ($topic && $account->uid > 0 && $topic->author_uid == $account->uid && user_access('create entity forum topic', $account));
  }
  return FALSE;
}

/**
 * Access callback for reply entities.
 *
 * @param string $op
 *   One of 'create', 'view', 'update', 'delete'.
 * @param EntityForumReply|null $reply
 *   The reply, or NULL for the 'create' operation.
 * @param object|null $account
 *   The user to check; defaults to the current user.
 *
 * @return bool
 *   Whether access is granted.
 */
function entity_forum_reply_access($op, $reply = NULL, $account = NULL, $entity_type = NULL) {
  if (!isset($account)) {
    $account = $GLOBALS['user'];
  }
  switch ($op) {
    case 'create':
      return user_access('create entity forum reply', $account);

    case 'view':
      return TRUE;

    case 'update':
    case 'delete':
      // The own-post check requires a logged-in account: uid 0 posts are
      // orphans/imports, never editable by anonymous visitors.
      return user_access('administer entity forum reply', $account)
        || ($reply && $account->uid > 0 && $reply->author_uid == $account->uid && user_access('create entity forum reply', $account));
  }
  return FALSE;
}

/**
 * Menu access callback: can the user view a topic (via its forum)?
 *
 * Topic visibility is inherited from the parent forum, so private forums
 * also hide their topics. The topic's own view access applies on top:
 * admin_only topics are restricted to moderators.
 *
 * @param EntityForumTopic $topic
 *   The topic being viewed.
 *
 * @return bool
 *   Whether access is granted.
 */
function entity_forum_topic_view_access($topic) {
  if (!entity_forum_topic_access('view', $topic)) {
    return FALSE;
  }
  $forum = entity_load('entity_forum_forum', $topic->forum_id);
  return $forum ? entity_forum_forum_access('view', $forum) : user_access('administer entity forum');
}

/**
 * Menu access callback: can the user post a new topic in this forum?
 *
 * Suspended members cannot post regardless of permissions.
 *
 * @param EntityForumForum $forum
 *   The forum to post in.
 *
 * @return bool
 *   Whether access is granted.
 */
function entity_forum_topic_create_access($forum) {
  // A container forum takes no topics at all. Checked here, in the one gate
  // the post links, the posting route and the forms all read, so nothing
  // else has to know about containers.
  return !entity_forum_forum_is_container($forum)
    && $forum->status
    && entity_forum_forum_access('view', $forum)
    && user_access('create entity forum topic')
    && entity_forum_user_posting_status() !== ENTITY_FORUM_POSTING_SUSPENDED;
}

/**
 * Menu access callback: can the user post a reply in this topic?
 *
 * Requires view access to the topic (forum visibility and admin_only
 * listing included), the reply-creation permission, an open topic, and —
 * for unpublished topics — moderator rights.
 *
 * @param EntityForumTopic $topic
 *   The topic being replied to.
 *
 * @return bool
 *   Whether access is granted.
 */
function entity_forum_reply_create_access($topic) {
  if (!$topic->status && !user_access('administer entity forum topic')) {
    return FALSE;
  }
  return !$topic->closed
    && entity_forum_topic_view_access($topic)
    && user_access('create entity forum reply')
    && entity_forum_user_posting_status() !== ENTITY_FORUM_POSTING_SUSPENDED;
}

/**
 * Menu access callback: may the current user close/reopen this topic?
 *
 * Author self-service closing is opt-in per forum (the author_close
 * setting) — a seller marking a classified ad sold is the motivating
 * case, but the rule is generic. Only the author of a live, published
 * topic qualifies; unpublished and held topics belong to the moderators.
 *
 * @param EntityForumTopic $topic
 *   The topic to close or reopen.
 * @param object|null $account
 *   The user to check; defaults to the current user.
 *
 * @return bool
 *   Whether access is granted.
 */
function entity_forum_topic_author_close_access($topic, $account = NULL) {
  if (!isset($account)) {
    $account = $GLOBALS['user'];
  }
  if ($account->uid <= 0 || (int) $topic->author_uid !== (int) $account->uid) {
    return FALSE;
  }
  if (!$topic->status || !empty($topic->pending)) {
    return FALSE;
  }
  $forum = entity_load('entity_forum_forum', $topic->forum_id);
  return $forum && !empty($forum->author_close)
    && user_access('create entity forum topic', $account)
    && entity_forum_topic_view_access($topic);
}

/**
 * Returns the content-discussion placement configured for a content type.
 *
 * A placement is the settings-page mapping that turns a content type into a
 * comments replacement. It carries the forum its discussion topics live in
 * and a scope:
 * - 'auto': every item of the type gets a discussion, find-or-created on
 *   first view (the original behaviour).
 * - 'item': the discussion appears only where the author enabled it on the
 *   node itself (a checkbox on the node form); nothing is created on view.
 *
 * @param string $node_type
 *   The content type machine name.
 *
 * @return array|null
 *   A normalized placement array ('forum' => int, 'scope' => 'auto'|'item'),
 *   or NULL when the type has no placement.
 */
function entity_forum_node_discussion_placement($node_type) {
  $map = config_get('entity_forum.settings', 'node_types');
  if (!is_array($map) || !isset($map[$node_type])) {
    return NULL;
  }
  $value = $map[$node_type];
  // Legacy format: a bare forum ID meant "every item of the type".
  if (!is_array($value)) {
    $value = array('forum' => $value);
  }
  $value += array('forum' => 0, 'scope' => 'auto');
  $value['forum'] = (int) $value['forum'];
  if (!in_array($value['scope'], array('auto', 'item'), TRUE)) {
    $value['scope'] = 'auto';
  }
  return $value;
}

/**
 * Returns the discussion forum configured for a content type.
 *
 * @param string $node_type
 *   The content type machine name.
 *
 * @return int
 *   The forum_id discussions for this type belong to, or 0 when the type
 *   has discussions disabled.
 */
function entity_forum_node_discussion_forum_id($node_type) {
  $placement = entity_forum_node_discussion_placement($node_type);
  return $placement ? $placement['forum'] : 0;
}

/**
 * Returns the topic attached to a node as its discussion thread.
 *
 * With $create, a missing topic is created on the spot (find-or-create):
 * unlisted (never in forum topic lists), published, titled after the
 * node, authored by the node author, with an empty body — the node
 * itself is the "opening post". Creation requires the node's content
 * type to have discussions enabled and the configured forum to exist.
 *
 * @param object $node
 *   The node.
 * @param bool $create
 *   Whether to create the topic when none exists yet.
 *
 * @return EntityForumTopic|false
 *   The discussion topic, or FALSE when there is none (and none was
 *   created).
 */
function entity_forum_node_topic($node, $create = FALSE) {
  $topic_id = (int) db_query('SELECT topic_id FROM {entity_forum_topic} WHERE node_id = :nid ORDER BY topic_id LIMIT 1', array(
    ':nid' => $node->nid,
  ))->fetchField();
  if ($topic_id) {
    $topic = entity_load('entity_forum_topic', $topic_id);
    return $topic ? $topic : FALSE;
  }
  if (!$create) {
    return FALSE;
  }
  $forum_id = entity_forum_node_discussion_forum_id($node->type);
  if (!$forum_id || !entity_load('entity_forum_forum', $forum_id)) {
    return FALSE;
  }
  $topic = entity_create('entity_forum_topic', array(
    'title' => $node->title,
    'content' => '',
    'forum_id' => $forum_id,
    'node_id' => (int) $node->nid,
    'listing' => ENTITY_FORUM_LISTING_UNLISTED,
    'author_uid' => (int) $node->uid,
  ));
  $topic->save();
  watchdog('entity_forum', 'Created discussion topic @tid for node @nid (@type).', array(
    '@tid' => $topic->id(),
    '@nid' => $node->nid,
    '@type' => $node->type,
  ), WATCHDOG_NOTICE);
  return $topic;
}

/**
 * Returns the path where a topic's discussion is read.
 *
 * Node-attached topics live on their node's page (the comments
 * replacement), so links and after-post redirects go there; normal
 * topics go to their own page.
 *
 * @param EntityForumTopic $topic
 *   The topic.
 *
 * @return string
 *   An internal path.
 */
function entity_forum_topic_discussion_path($topic) {
  return !empty($topic->node_id) ? 'node/' . $topic->node_id : 'topic/' . $topic->id();
}

/**
 * Implements hook_node_view().
 *
 * Renders the discussion thread (threaded replies + reply/report links)
 * below nodes of discussion-enabled content types — the comments
 * replacement. The topic is find-or-created on first full view of a
 * published node; viewers only see the section when they may view the
 * topic (the configured forum's visibility applies).
 */
function entity_forum_node_view($node, $view_mode, $langcode) {
  if ($view_mode !== 'full' || empty($node->status) || !empty($node->in_preview)) {
    return;
  }
  $placement = entity_forum_node_discussion_placement($node->type);
  if (!$placement || !$placement['forum']) {
    return;
  }
  // Per-item placements render only where the discussion was enabled on the
  // node (a published attached topic exists); the topic is created from the
  // node form, never here. Whole-type placements find-or-create on first
  // view as before. Topic 'view' access does not consider status, so the
  // published check is made explicitly.
  if ($placement['scope'] === 'item') {
    $topic = entity_forum_node_topic($node);
    if (!$topic || !$topic->status) {
      return;
    }
  }
  else {
    $topic = entity_forum_node_topic($node, TRUE);
  }
  if (!$topic || !entity_forum_topic_view_access($topic)) {
    return;
  }
  module_load_include('inc', 'entity_forum', 'entity_forum.pages');
  $node->content['entity_forum_discussion'] = entity_forum_node_discussion_build($topic);
}

/**
 * Implements hook_node_delete().
 *
 * A node's discussion topic (and its replies, via the cascade) goes with
 * the node — the same semantics core comments have.
 */
function entity_forum_node_delete($node) {
  $topic_ids = db_query('SELECT topic_id FROM {entity_forum_topic} WHERE node_id = :nid', array(
    ':nid' => $node->nid,
  ))->fetchCol();
  if ($topic_ids) {
    entity_get_controller('entity_forum_topic')->delete($topic_ids);
    watchdog('entity_forum', 'Deleted discussion topic(s) @tids with node @nid.', array(
      '@tids' => implode(', ', $topic_ids),
      '@nid' => $node->nid,
    ), WATCHDOG_NOTICE);
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * Content types whose discussion placement is scoped 'item' get a per-node
 * checkbox — the author decides which individual pieces of content show a
 * forum discussion. Types scoped 'auto' (every item) and types with no
 * placement are left alone. The checkbox reflects whether a published
 * discussion topic already exists for the node.
 *
 * The control gets its OWN "Forum Discussions" vertical tab, deliberately
 * separate from core's "Comment settings" tab: a forum discussion is a
 * distinct system from core comments (a site typically runs one or the
 * other), and nesting inside core's tab both tied the option's visibility to
 * the core comment permission and left core's Open/Closed tab summary — driven
 * by core's own JS — unable to reflect our checkbox. The tab carries no live
 * summary, keeping the module JS-free by design.
 */
function entity_forum_form_node_form_alter(&$form, &$form_state, $form_id) {
  $node = $form_state['node'];
  $placement = entity_forum_node_discussion_placement($node->type);
  if (!$placement || !$placement['forum'] || $placement['scope'] !== 'item') {
    return;
  }

  $forum = entity_load('entity_forum_forum', $placement['forum']);
  $topic = entity_forum_node_topic($node);

  $form['entity_forum_discussion_settings'] = array(
    '#type' => 'fieldset',
    '#title' => t('Forum Discussions'),
    '#collapsible' => TRUE,
    '#collapsed' => TRUE,
    '#group' => 'additional_settings',
    '#weight' => 30,
  );
  $form['entity_forum_discussion_settings']['entity_forum_discussion'] = array(
    '#type' => 'checkbox',
    '#title' => t('Show a forum discussion below this content'),
    // Pin the value key so the submit handler reads the same place no matter
    // where the element sits in the form tree.
    '#parents' => array('entity_forum_discussion'),
    '#default_value' => ($topic && $topic->status),
    '#description' => $forum
      ? t('Members can post replies below this content, in the %forum forum. Unticking hides the discussion; any existing replies are kept.', array('%forum' => $forum->title))
      : t('Members can post replies below this content. Unticking hides the discussion; any existing replies are kept.'),
  );

  // Runs after node_form_submit(), so the node is saved and has an nid.
  $form['actions']['submit']['#submit'][] = 'entity_forum_node_form_discussion_submit';
}

/**
 * Submit handler: apply the per-node "show a discussion" choice.
 *
 * Enabling find-or-creates the node's discussion topic and (re)publishes it;
 * disabling unpublishes an existing topic so it stops rendering while its
 * replies survive and re-enabling brings the same thread back. Never deletes
 * — node deletion is the only thing that removes a discussion (hook_node_delete).
 */
function entity_forum_node_form_discussion_submit($form, &$form_state) {
  $node = $form_state['node'];
  $enabled = !empty($form_state['values']['entity_forum_discussion']);

  if ($enabled) {
    $topic = entity_forum_node_topic($node, TRUE);
    if ($topic && !$topic->status) {
      $topic->status = 1;
      $topic->save();
    }
  }
  else {
    $topic = entity_forum_node_topic($node);
    if ($topic && $topic->status) {
      $topic->status = 0;
      $topic->save();
    }
  }
}

/**
 * Menu access callback: may the current user report this post?
 *
 * Reporting is for logged-in members who can actually see the post:
 * view access to the topic (forum visibility and admin_only listing
 * included) is required, and the target must exist and be published.
 *
 * @param string $type
 *   'topic' or 'reply' (the URL fragment, not the entity type).
 * @param int $id
 *   The entity ID.
 *
 * @return bool
 *   Whether access is granted.
 */
function entity_forum_report_access($type, $id) {
  if (!user_is_logged_in() || !in_array($type, array('topic', 'reply'), TRUE)) {
    return FALSE;
  }
  $entity = entity_load("entity_forum_$type", $id);
  if (!$entity || !$entity->status) {
    return FALSE;
  }
  $topic = $type === 'topic' ? $entity : entity_load('entity_forum_topic', $entity->topic_id);
  return $topic ? entity_forum_topic_view_access($topic) : FALSE;
}

/**
 * Files a report about a forum post for moderator attention.
 *
 * One open report per member per post: while the member already has an
 * unresolved report on the target, no duplicate row is created. The
 * reporter's display name is snapshotted like post author names, so the
 * report stays attributable after account deletion.
 *
 * @param string $entity_type
 *   entity_forum_topic or entity_forum_reply.
 * @param int $entity_id
 *   The reported entity ID.
 * @param string $reason
 *   The reporter's reason.
 * @param object|null $account
 *   The reporting account; defaults to the current user.
 *
 * @return int|false
 *   The new report_id, or FALSE when the member already has an open
 *   report on this post.
 */
function entity_forum_report_create($entity_type, $entity_id, $reason, $account = NULL) {
  if (!isset($account)) {
    $account = $GLOBALS['user'];
  }
  $open = db_query('SELECT report_id FROM {entity_forum_report} WHERE entity_type = :type AND entity_id = :id AND reporter_uid = :uid AND resolved = 0', array(
    ':type' => $entity_type,
    ':id' => $entity_id,
    ':uid' => $account->uid,
  ))->fetchField();
  if ($open) {
    return FALSE;
  }
  $report_id = db_insert('entity_forum_report')
    ->fields(array(
      'entity_type' => $entity_type,
      'entity_id' => $entity_id,
      'reporter_uid' => (int) $account->uid,
      'reporter_name' => entity_forum_user_display_name($account),
      'reason' => $reason,
      'created' => REQUEST_TIME,
    ))
    ->execute();
  watchdog('entity_forum', 'Content reported: @type @id by uid @uid (report @rid).', array(
    '@type' => $entity_type,
    '@id' => $entity_id,
    '@uid' => $account->uid,
    '@rid' => $report_id,
  ), WATCHDOG_NOTICE);
  return (int) $report_id;
}

/**
 * Returns open-report counts for every post of a topic.
 *
 * Used to highlight reported posts to moderators inside the thread
 * itself (topic page and node discussions), so reported content is
 * easy to spot in place. One indexed query per rendered topic, and
 * callers only invoke it for moderators.
 *
 * @param int $topic_id
 *   The topic whose posts are checked.
 *
 * @return array
 *   Two maps of open (unresolved) report counts:
 *   - topic: keyed by topic_id.
 *   - reply: keyed by reply_id.
 */
function entity_forum_topic_open_reports($topic_id) {
  $cache = &backdrop_static(__FUNCTION__, array());
  if (isset($cache[$topic_id])) {
    return $cache[$topic_id];
  }
  $map = array('topic' => array(), 'reply' => array());
  $rows = db_query("SELECT r.entity_type, r.entity_id, COUNT(r.report_id) AS reports
    FROM {entity_forum_report} r
    WHERE r.resolved = 0 AND (
      (r.entity_type = 'entity_forum_topic' AND r.entity_id = :tid1)
      OR (r.entity_type = 'entity_forum_reply' AND r.entity_id IN (SELECT reply_id FROM {entity_forum_reply} WHERE topic_id = :tid2))
    )
    GROUP BY r.entity_type, r.entity_id", array(':tid1' => $topic_id, ':tid2' => $topic_id));
  foreach ($rows as $row) {
    $key = $row->entity_type === 'entity_forum_topic' ? 'topic' : 'reply';
    $map[$key][(int) $row->entity_id] = (int) $row->reports;
  }
  $cache[$topic_id] = $map;
  return $map;
}

/**
 * Builds the moderator-only "reported content" badge for a post.
 *
 * @param int $count
 *   Number of open reports on the post.
 *
 * @return string
 *   Badge markup linking to the moderation queue.
 */
function entity_forum_reported_badge($count) {
  return '<div class="entity-forum-reported-flag">' . l(
    format_plural($count, 'Reported content — 1 open report', 'Reported content — @count open reports'),
    'forums/moderation'
  ) . '</div>';
}

/**
 * Implements hook_modules_enabled().
 *
 * Warns the administrator immediately when a conflicting forum module is
 * enabled while Entity Forum is active. hook_requirements() blocks installing
 * Entity Forum second; this covers the reverse order, which nothing can block.
 */
function entity_forum_modules_enabled($modules) {
  $conflicting = array_intersect($modules, array('forum', 'forum_ng'));
  if ($conflicting) {
    backdrop_set_message(t('The %modules module(s) conflict with Entity Forum: both provide forum pages on the same URLs and cannot be active at the same time. Disable one of them. See the <a href="@status">status report</a>.', array(
      '%modules' => implode(', ', $conflicting),
      '@status' => url('admin/reports/status'),
    )), 'warning');
    watchdog('entity_forum', 'Conflicting forum module(s) enabled alongside Entity Forum: @modules.', array(
      '@modules' => implode(', ', $conflicting),
    ), WATCHDOG_WARNING);
  }
}

/**
 * Implements hook_user_predelete().
 *
 * Safety net: forum content must never be mass-deleted because a member's
 * account is removed. Whatever path deletes the account (cancel form, bulk
 * admin action, direct user_delete() API call), the member's posts are
 * kept: the author_name snapshot is filled from the account being deleted,
 * and author_uid is flipped to its negative — the "last uid". That makes
 * former-member posts trivially queryable (author_uid < 0, e.g. in a
 * View) and reinstatable to a new account via
 * entity_forum_reassign_user_content(-$old_uid, $new_uid). Bylines render
 * as "Name (no longer a member)". A future membership module can offer
 * richer choices before this hook runs.
 */
function entity_forum_user_predelete($account) {
  $name = entity_forum_user_display_name($account);
  $total = 0;
  foreach (array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply') as $table) {
    // Fill the snapshot where a pre-snapshot row never got one.
    db_update($table)
      ->fields(array('author_name' => $name))
      ->condition('author_uid', $account->uid)
      ->condition('author_name', '')
      ->execute();
    // Flip to the negative "last uid".
    $total += db_update($table)
      ->fields(array('author_uid' => -(int) $account->uid))
      ->condition('author_uid', $account->uid)
      ->execute();
    entity_get_controller($table)->resetCache();
  }
  if ($total) {
    watchdog('entity_forum', 'Preserved @count forum item(s) by @name (deleted uid @uid): author_name snapshotted, author_uid flipped to -@uid.', array(
      '@count' => $total,
      '@name' => $name,
      '@uid' => $account->uid,
    ), WATCHDOG_NOTICE);
  }

  // Reports keep their reporter_name snapshot from filing time; flip the
  // uid negative like post authors so they stay queryable/reinstatable.
  db_update('entity_forum_report')
    ->fields(array('reporter_uid' => -(int) $account->uid))
    ->condition('reporter_uid', $account->uid)
    ->execute();

  // Release and delete the member's forum picture, if any.
  entity_forum_avatar_save($account, 0);
}

/**
 * Returns the forum display name for a user account.
 *
 * The user's own forum posting name (a "handle" they can set on their
 * account page) when set, otherwise the account name. Deliberately free
 * of any site-specific fields so the module works on any site; importers
 * that know a better name (e.g. a migrated WordPress display name) should
 * seed the posting name instead.
 *
 * @param object $account
 *   A user account.
 *
 * @return string
 *   The display name.
 */
function entity_forum_user_display_name($account) {
  if (!empty($account->data['entity_forum_posting_name'])) {
    return $account->data['entity_forum_posting_name'];
  }
  return $account->name;
}

/**
 * Renders a post author for bylines and listings.
 *
 * - Live account: the forum display name, linked to the profile when the
 *   viewer may access profiles.
 * - Deleted account (negative/dangling uid): the stored author_name
 *   snapshot with a "(no longer a member)" suffix.
 * - No information at all: "No longer a member" (e.g. authors that were
 *   already deleted from the old WordPress site before migration).
 *
 * @param int $uid
 *   The stored author_uid (may be negative or dangling).
 * @param string $author_name
 *   The stored author_name snapshot.
 *
 * @return string
 *   Sanitized author HTML.
 */
function entity_forum_format_author($uid, $author_name = '') {
  $account = $uid > 0 ? user_load($uid) : FALSE;
  if ($account) {
    $name = entity_forum_user_display_name($account);
    return user_access('access user profiles')
      ? l($name, 'user/' . $account->uid)
      : check_plain($name);
  }
  if ($author_name !== '' && $author_name !== NULL) {
    return t('@name <span class="entity-forum-former-member">(no longer a member)</span>', array('@name' => $author_name));
  }
  return '<span class="entity-forum-former-member">' . t('No longer a member') . '</span>';
}

/**
 * Implements hook_entity_property_info_alter().
 *
 * The schema-derived property defaults from entity_plus type every int
 * column as 'integer', so Views gets numeric handlers and shows raw
 * timestamps and bare IDs. Retyping the timestamp columns as 'date' and
 * the reference columns as their entity type makes entity_plus generate
 * date handlers and Views relationships (e.g. topic → author user,
 * topic → last reply → author for "last poster" columns).
 *
 * Note: author_uid can be 0 (unknown importer authors) or negative
 * (deleted accounts) — those rows simply don't join; author_name is the
 * plain-text fallback for them.
 */
function entity_forum_entity_property_info_alter(&$info) {
  $types = array(
    'entity_forum_forum' => array(
      'created' => 'date',
      'changed' => 'date',
      'author_uid' => 'user',
      'parent_id' => 'entity_forum_forum',
    ),
    'entity_forum_topic' => array(
      'created' => 'date',
      'changed' => 'date',
      'last_active_time' => 'date',
      'author_uid' => 'user',
      'forum_id' => 'entity_forum_forum',
      'last_reply_id' => 'entity_forum_reply',
      'node_id' => 'node',
    ),
    'entity_forum_reply' => array(
      'created' => 'date',
      'changed' => 'date',
      'author_uid' => 'user',
      'forum_id' => 'entity_forum_forum',
      'topic_id' => 'entity_forum_topic',
      'reply_to_id' => 'entity_forum_reply',
    ),
  );
  $labels = array(
    'last_active_time' => t('Last active time'),
    'author_uid' => t('Author'),
    'author_name' => t('Author name (snapshot)'),
    'forum_id' => t('Forum'),
    'topic_id' => t('Topic'),
    'parent_id' => t('Parent forum'),
    'last_reply_id' => t('Last reply'),
    'reply_to_id' => t('Replied to'),
    'reply_count' => t('Reply count'),
    'voice_count' => t('Voices'),
    'attachment_count' => t('Attachment count'),
    'listing' => t('Topic list visibility'),
    'pending' => t('Awaiting review'),
    'node_id' => t('Attached content'),
    'type' => t('Topic type'),
  );
  foreach ($types as $entity_type => $columns) {
    if (!isset($info[$entity_type]['properties'])) {
      continue;
    }
    $properties = &$info[$entity_type]['properties'];
    foreach ($columns as $column => $type) {
      if (isset($properties[$column])) {
        $properties[$column]['type'] = $type;
      }
    }
    foreach ($labels as $column => $label) {
      if (isset($properties[$column])) {
        $properties[$column]['label'] = $label;
      }
    }
    unset($properties);
  }
}

/**
 * Returns the forum picture file ID for a user account.
 *
 * The picture is a managed file owned by entity_forum (usage type
 * 'user'), stored in the account data array like the posting name — the
 * module deliberately avoids site-specific fields and core's user
 * picture. Importers may seed it (e.g. from a migrated WordPress
 * avatar) with entity_forum_avatar_save().
 *
 * @param object|int $account
 *   A user account or uid.
 *
 * @return int
 *   The managed file ID, or 0 when the account has no forum picture.
 */
function entity_forum_user_avatar_fid($account) {
  if (is_numeric($account)) {
    $account = $account > 0 ? user_load($account) : FALSE;
  }
  if ($account && !empty($account->data['entity_forum_avatar_fid'])) {
    return (int) $account->data['entity_forum_avatar_fid'];
  }
  return 0;
}

/**
 * Renders a post author's forum picture.
 *
 * Falls back to the default picture (see
 * entity_forum_format_default_avatar()) when the author has none —
 * including deleted and unknown authors (uid <= 0), whose account data
 * is gone.
 *
 * @param int $uid
 *   Author user ID.
 * @param string $style
 *   Image style to render with.
 *
 * @return string
 *   Image markup.
 */
function entity_forum_format_avatar($uid, $style = 'entity_forum_avatar') {
  $fid = $uid > 0 ? entity_forum_user_avatar_fid($uid) : 0;
  if (!$fid || !($file = file_load($fid))) {
    return entity_forum_format_default_avatar($style);
  }
  return theme('image_style', array(
    'style_name' => $style,
    'uri' => $file->uri,
    'alt' => '',
    'attributes' => array('class' => array('entity-forum-avatar-img')),
  ));
}

/**
 * Renders the default forum picture.
 *
 * An administrator-uploaded image (entity_forum.settings
 * avatar_default_fid, set at admin/content/entity-forum/settings) when
 * one exists, otherwise the module's shipped SVG silhouette — rendered
 * as a plain image sized to match the style, because SVGs cannot pass
 * through image styles.
 *
 * @param string $style
 *   Image style the picture must match.
 *
 * @return string
 *   Image markup.
 */
function entity_forum_format_default_avatar($style = 'entity_forum_avatar') {
  $fid = (int) config_get('entity_forum.settings', 'avatar_default_fid');
  if ($fid && ($file = file_load($fid))) {
    return theme('image_style', array(
      'style_name' => $style,
      'uri' => $file->uri,
      'alt' => '',
      'attributes' => array('class' => array('entity-forum-avatar-img', 'entity-forum-avatar-default')),
    ));
  }

  // Size the SVG to the style's scale/crop dimensions.
  $size = 96;
  if (($style_info = image_style_load($style)) && !empty($style_info['effects'])) {
    $effect = reset($style_info['effects']);
    if (!empty($effect['data']['width'])) {
      $size = (int) $effect['data']['width'];
    }
  }
  return theme('image', array(
    'uri' => backdrop_get_path('module', 'entity_forum') . '/images/avatar-default-symbolic.svg',
    'alt' => '',
    'width' => $size,
    'height' => $size,
    'attributes' => array('class' => array('entity-forum-avatar-img', 'entity-forum-avatar-default')),
  ));
}

/**
 * Saves (or clears) a member's forum picture.
 *
 * Handles the managed-file bookkeeping: marks a new file permanent and
 * records usage; releases and deletes the previous file when replaced or
 * cleared. Persists the fid in the account data array.
 *
 * @param object $account
 *   The account the picture belongs to.
 * @param int $fid
 *   The new managed file ID, or 0 to clear the picture.
 */
function entity_forum_avatar_save($account, $fid) {
  $fid = (int) $fid;
  $old_fid = entity_forum_user_avatar_fid($account);
  if ($old_fid === $fid) {
    return;
  }

  if ($fid && ($file = file_load($fid))) {
    $file->status = FILE_STATUS_PERMANENT;
    file_save($file);
    file_usage_add($file, 'entity_forum', 'user', $account->uid);
  }
  if ($old_fid && ($old_file = file_load($old_fid))) {
    file_usage_delete($old_file, 'entity_forum', 'user', $account->uid);
    file_delete($old_file->fid);
  }

  $data = $account->data;
  if ($fid) {
    $data['entity_forum_avatar_fid'] = $fid;
  }
  else {
    unset($data['entity_forum_avatar_fid']);
  }
  db_update('users')
    ->fields(array('data' => serialize($data)))
    ->condition('uid', $account->uid)
    ->execute();
  $account->data = $data;
  entity_get_controller('user')->resetCache(array($account->uid));
}

/**
 * Renders a post author's signature for the bottom of their posts.
 *
 * Follows core comment behaviour: shown only when the site has signatures
 * enabled (admin/config/people/settings → Personalization) and the author
 * is a live account with a signature set. The signature runs through its
 * own text format and core's user_signature theme. Deleted and unknown
 * authors have no account, so no signature.
 *
 * @param int $uid
 *   Author user ID (may be 0 or negative for gone/unknown authors).
 *
 * @return string
 *   Rendered signature markup, or an empty string.
 */
function entity_forum_format_signature($uid) {
  if ($uid <= 0 || !config_get('system.core', 'user_signatures')) {
    return '';
  }
  $account = user_load($uid);
  if (!$account || !isset($account->signature) || trim($account->signature) === '') {
    return '';
  }
  $signature = check_markup($account->signature, $account->signature_format, '', TRUE);
  return '<div class="entity-forum-signature">' . theme('user_signature', array('signature' => $signature)) . '</div>';
}

/**
 * Implements hook_entity_load().
 *
 * Exposes the author as a standard 'uid' property alongside author_uid.
 * Modules that key ownership off $entity->uid — notably Field Permissions'
 * "own" field permissions — can then recognise a forum post's author.
 * Deleted-author posts (author_uid <= 0) get uid 0, so no live account is
 * ever treated as their owner.
 */
function entity_forum_entity_load($entities, $type) {
  if (in_array($type, array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply'), TRUE)) {
    foreach ($entities as $entity) {
      $entity->uid = (isset($entity->author_uid) && $entity->author_uid > 0) ? (int) $entity->author_uid : 0;
    }
  }
}

/**
 * Implements hook_entity_presave().
 *
 * Snapshots the author display name onto every forum entity at save time,
 * so attribution survives the account's later deletion.
 */
function entity_forum_entity_presave($entity, $type) {
  if (in_array($type, array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply'), TRUE)) {
    if ((!isset($entity->author_name) || $entity->author_name === '') && !empty($entity->author_uid) && $entity->author_uid > 0) {
      $account = user_load($entity->author_uid);
      if ($account) {
        $entity->author_name = entity_forum_user_display_name($account);
      }
    }
  }

  // A reply's type is its topic's type, never its own choice — the single
  // point where that is enforced, so no caller has to remember it (the
  // importer, the frontend form and any API save all go through here).
  // Kept alongside forum_id, which is denormalized from the topic the same
  // way.
  if ($type === 'entity_forum_reply' && !empty($entity->topic_id)) {
    $topic_type = db_query('SELECT type FROM {entity_forum_topic} WHERE topic_id = :id', array(
      ':id' => $entity->topic_id,
    ))->fetchField();
    if ($topic_type) {
      $entity->type = $topic_type;
    }
  }

  // The pending flag only marks posts still held for review, so releasing
  // the hold by ANY route — the queue's Approve action, the admin edit
  // forms, or API saves — drops the post out of the moderation queue.
  if ($type === 'entity_forum_topic' && !empty($entity->pending) && $entity->listing !== ENTITY_FORUM_LISTING_ADMIN_ONLY) {
    $entity->pending = 0;
  }
  if ($type === 'entity_forum_reply' && !empty($entity->pending) && !empty($entity->status)) {
    $entity->pending = 0;
  }
  if (in_array($type, array('entity_forum_topic', 'entity_forum_reply'), TRUE)
    && empty($entity->pending) && !empty($entity->pending_reason)) {
    $entity->pending_reason = '';
  }
}

/**
 * Re-attributes all forum content owned by a user to another user.
 *
 * This is the reinstatement API: a deleted member's posts keep their last
 * uid flipped negative, so to reinstate them to a new account call
 * entity_forum_reassign_user_content(-$old_uid, $new_uid). Uses direct
 * queries (not entity saves) so a member with thousands of posts
 * reassigns instantly; the denormalized topic statistics are unaffected
 * by authorship changes. Note: the author_name snapshot is deliberately
 * left untouched — refresh it separately if the new account should be
 * displayed instead.
 *
 * @param int $uid
 *   The current owner (negative for a deleted member's last uid).
 * @param int $new_uid
 *   The new owner.
 *
 * @return int
 *   Total number of reassigned records.
 */
function entity_forum_reassign_user_content($uid, $new_uid) {
  $total = 0;
  foreach (array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply') as $table) {
    $total += db_update($table)
      ->fields(array('author_uid' => $new_uid))
      ->condition('author_uid', $uid)
      ->execute();
    entity_get_controller($table)->resetCache();
  }
  if ($total) {
    watchdog('entity_forum', 'Re-attributed @count forum item(s) from user @uid to user @new_uid.', array(
      '@count' => $total,
      '@uid' => $uid,
      '@new_uid' => $new_uid,
    ), WATCHDOG_NOTICE);
  }
  return $total;
}

/**
 * Counts forum content (forums + topics + replies) authored by a user.
 *
 * @param int $uid
 *   The user ID.
 *
 * @return int
 *   Number of forum records the user authored.
 */
function entity_forum_user_content_count($uid) {
  return (int) db_query('SELECT
    (SELECT COUNT(*) FROM {entity_forum_forum} WHERE author_uid = :uid)
    + (SELECT COUNT(*) FROM {entity_forum_topic} WHERE author_uid = :uid)
    + (SELECT COUNT(*) FROM {entity_forum_reply} WHERE author_uid = :uid)', array(':uid' => $uid))->fetchField();
}

/**
 * Implements hook_form_FORM_ID_alter() for user_cancel_confirm_form().
 *
 * Tells the administrator how many forum posts the member has and that
 * they are kept whichever cancellation method is chosen: bylines switch to
 * the member's name with "(no longer a member)", and the posts stay
 * reinstatable to a new account later.
 */
function entity_forum_form_user_cancel_confirm_form_alter(&$form, &$form_state) {
  $account = $form_state['build_info']['args'][0];
  $count = entity_forum_user_content_count($account->uid);
  if ($count) {
    $form['entity_forum_notice'] = array(
      '#markup' => '<div class="messages info">' . format_plural($count,
        'This member has 1 forum post. Forum posts are never deleted with an account: whichever method is chosen, the post is kept, shown as "@name (no longer a member)", and can be reinstated to a new account later.',
        'This member has @count forum posts. Forum posts are never deleted with an account: whichever method is chosen, the posts are kept, shown as "@name (no longer a member)", and can be reinstated to a new account later.',
        array('@name' => entity_forum_user_display_name($account))) . '</div>',
      '#weight' => -10,
    );
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_multiple_cancel_confirm().
 *
 * Same notice as the single-account form, for the bulk cancel action.
 */
function entity_forum_form_user_multiple_cancel_confirm_alter(&$form, &$form_state) {
  $form['entity_forum_notice'] = array(
    '#markup' => '<div class="messages info">' . t('Forum posts are never deleted with an account: whichever method is chosen, they are kept, shown under the member\'s name as "(no longer a member)", and can be reinstated to a new account later.') . '</div>',
    '#weight' => -10,
  );
}

/**
 * Implements hook_entity_insert().
 *
 * Keeps the denormalized reply statistics on topics current whenever a
 * reply is created — by forms, the importer, or any other API user.
 */
function entity_forum_entity_insert($entity, $type) {
  if (in_array($type, array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply'), TRUE)) {
    entity_forum_forum_counts_reset();
  }
  if ($type === 'entity_forum_reply') {
    entity_forum_topic_recalculate_stats((int) $entity->topic_id);
  }
  // Field files land wherever the field's upload destination says, which
  // knows nothing about forum privacy — see entity_forum_rescheme_post_files().
  if ($type === 'entity_forum_topic' || $type === 'entity_forum_reply') {
    entity_forum_rescheme_post_files($type, $entity->id());
  }
}

/**
 * Implements hook_entity_update().
 */
function entity_forum_entity_update($entity, $type) {
  if (in_array($type, array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply'), TRUE)) {
    entity_forum_forum_counts_reset();
  }
  if ($type === 'entity_forum_reply') {
    entity_forum_topic_recalculate_stats((int) $entity->topic_id);
    // If the reply moved to a different topic, refresh the old one too.
    if (isset($entity->original) && $entity->original->topic_id != $entity->topic_id) {
      entity_forum_topic_recalculate_stats((int) $entity->original->topic_id);
    }
  }

  // Keep attachment storage in sync with forum visibility, so a post
  // moving into a private forum (or a forum turning private) re-homes its
  // files to private:// and vice versa.
  if ($type === 'entity_forum_forum' && isset($entity->original) && $entity->original->visibility !== $entity->visibility) {
    entity_forum_rescheme_forum_files((int) $entity->forum_id);
  }
  if ($type === 'entity_forum_topic' && isset($entity->original) && $entity->original->forum_id != $entity->forum_id) {
    // Keep replies' denormalized forum_id in step with the topic's new
    // forum. This must happen BEFORE any re-scheming: the scheme a file
    // belongs in is read from the post's forum_id, so a stale one would
    // re-home the replies' files to the forum the topic just left.
    db_update('entity_forum_reply')
      ->fields(array('forum_id' => (int) $entity->forum_id))
      ->condition('topic_id', (int) $entity->topic_id)
      ->execute();
    entity_get_controller('entity_forum_reply')->resetCache();
    foreach (db_query('SELECT reply_id FROM {entity_forum_reply} WHERE topic_id = :tid', array(':tid' => $entity->topic_id))->fetchCol() as $reply_id) {
      entity_forum_rescheme_post_files('entity_forum_reply', $reply_id);
    }
  }

  // The post's own files, every save — a new upload, or a field whose
  // destination does not match the forum's privacy.
  if ($type === 'entity_forum_topic' || $type === 'entity_forum_reply') {
    entity_forum_rescheme_post_files($type, $entity->id());
  }
}

/**
 * Implements hook_entity_delete().
 *
 * Cascades topic deletion to its replies and refreshes topic statistics
 * when replies are removed.
 */
function entity_forum_entity_delete($entity, $type) {
  if (in_array($type, array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply'), TRUE)) {
    entity_forum_forum_counts_reset();
  }
  // Reports about a deleted post are moot — remove them. Topic deletion
  // cascades to replies below, and each cascaded reply delete comes back
  // through this hook, so reply reports are covered too.
  if (in_array($type, array('entity_forum_topic', 'entity_forum_reply'), TRUE)) {
    db_delete('entity_forum_report')
      ->condition('entity_type', $type)
      ->condition('entity_id', (int) $entity->id())
      ->execute();
  }
  if ($type === 'entity_forum_topic') {
    $reply_ids = db_query('SELECT reply_id FROM {entity_forum_reply} WHERE topic_id = :topic_id', array(
      ':topic_id' => $entity->topic_id,
    ))->fetchCol();
    if ($reply_ids) {
      entity_get_controller('entity_forum_reply')->delete($reply_ids);
    }
  }
  elseif ($type === 'entity_forum_reply') {
    entity_forum_topic_recalculate_stats((int) $entity->topic_id);
  }
}

/**
 * Recalculates the denormalized reply statistics for a topic.
 *
 * Recomputes reply_count, last_reply_id, last_active_time, voice_count
 * (distinct participants) and attachment_count from the published replies
 * and {file_usage} rows actually stored, rather than incrementing
 * counters, so it is safe to call at any time (including after bulk
 * imports).
 *
 * @param int $topic_id
 *   The topic to refresh.
 */
function entity_forum_topic_recalculate_stats($topic_id) {
  $topic_created = db_query('SELECT created FROM {entity_forum_topic} WHERE topic_id = :topic_id', array(
    ':topic_id' => $topic_id,
  ))->fetchField();
  if ($topic_created === FALSE) {
    // Topic is gone (e.g. cascading delete); nothing to update.
    return;
  }

  $stats = db_query('SELECT COUNT(reply_id) AS reply_count, MAX(created) AS last_created FROM {entity_forum_reply} WHERE topic_id = :topic_id AND status = 1', array(
    ':topic_id' => $topic_id,
  ))->fetchObject();

  $last_reply_id = 0;
  if ($stats->reply_count) {
    $last_reply_id = db_query('SELECT reply_id FROM {entity_forum_reply} WHERE topic_id = :topic_id AND status = 1 ORDER BY created DESC, reply_id DESC LIMIT 1', array(
      ':topic_id' => $topic_id,
    ))->fetchField();
  }

  // Distinct participants: topic author + published repliers ("Voices").
  // Unknown authors (uid 0) merge into one voice, matching bbPress.
  $voice_count = (int) db_query('SELECT COUNT(DISTINCT author_uid) FROM (SELECT author_uid FROM {entity_forum_reply} WHERE topic_id = :tid1 AND status = 1 UNION SELECT author_uid FROM {entity_forum_topic} WHERE topic_id = :tid2) participants', array(
    ':tid1' => $topic_id,
    ':tid2' => $topic_id,
  ))->fetchField();

  // Files used by the topic post and its published replies, whichever field
  // they arrived in — the count is "how many files are on this thread", not
  // "how many did one particular mechanism put there".
  $attachment_count = (int) db_query("SELECT COUNT(*) FROM {file_usage} fu WHERE (fu.type = 'entity_forum_topic' AND fu.id = :tid1) OR (fu.type = 'entity_forum_reply' AND fu.id IN (SELECT reply_id FROM {entity_forum_reply} WHERE topic_id = :tid2 AND status = 1))", array(
    ':tid1' => $topic_id,
    ':tid2' => $topic_id,
  ))->fetchField();

  db_update('entity_forum_topic')
    ->fields(array(
      'reply_count' => (int) $stats->reply_count,
      'last_reply_id' => (int) $last_reply_id,
      'last_active_time' => max((int) $topic_created, (int) $stats->last_created),
      'voice_count' => max(1, $voice_count),
      'attachment_count' => $attachment_count,
    ))
    ->condition('topic_id', $topic_id)
    ->execute();
  entity_get_controller('entity_forum_topic')->resetCache(array($topic_id));
}

/**
 * Returns the number of published topics in a forum.
 *
 * @param int $forum_id
 *   The forum ID.
 *
 * @return int
 *   Count of published topics.
 */
function entity_forum_forum_topic_count($forum_id) {
  $counts = entity_forum_forum_counts();
  return isset($counts[$forum_id]) ? $counts[$forum_id]['topic_count'] : 0;
}

/**
 * Returns aggregate post counts and last activity for every forum.
 *
 * Built with two grouped queries (topics, replies) plus an in-PHP rollup
 * of each forum's descendants into it — so a parent forum's totals
 * include everything in its sub-forums (bbPress behaviour). The whole map
 * is computed once and cached, both per-request (backdrop_static) and in
 * the 'cache' bin; entity_forum_forum_counts_reset() clears it when
 * forums, topics or replies change. Reading a single forum's count is
 * therefore free of per-row SQL, which keeps the forums index (and any
 * Views forum list) from doing N+1 count queries.
 *
 * @return array
 *   Map keyed by forum_id, each value an array with:
 *   - topic_count: published topics in the forum and its descendants.
 *   - post_count: topics + published replies (bbPress "Posts").
 *   - reply_count: published replies only.
 *   - last_active_time: newest topic last-activity timestamp, or 0.
 */
function entity_forum_forum_counts() {
  $cache = &backdrop_static(__FUNCTION__);
  if (isset($cache)) {
    return $cache;
  }
  if ($cached = cache_get('entity_forum_forum_counts')) {
    $cache = $cached->data;
    return $cache;
  }

  // Every forum starts at zero so childless forums are represented.
  $map = array();
  foreach (db_query('SELECT forum_id, parent_id FROM {entity_forum_forum}') as $forum) {
    $map[$forum->forum_id] = array(
      'topic_count' => 0,
      'reply_count' => 0,
      'post_count' => 0,
      'last_active_time' => 0,
      'parent_id' => (int) $forum->parent_id,
    );
  }

  // Direct (non-rolled-up) tallies: two grouped queries. Only normally
  // listed topics count — admin_only and unlisted topics (and their
  // replies) are invisible in lists, and the map is cached globally, so
  // it must reflect what the public sees.
  $topic_rows = db_query('SELECT forum_id, COUNT(topic_id) AS topics, MAX(last_active_time) AS last_active FROM {entity_forum_topic} WHERE status = 1 AND listing = :listing GROUP BY forum_id', array(
    ':listing' => ENTITY_FORUM_LISTING_NORMAL,
  ));
  foreach ($topic_rows as $row) {
    if (isset($map[$row->forum_id])) {
      $map[$row->forum_id]['topic_count'] = (int) $row->topics;
      $map[$row->forum_id]['last_active_time'] = (int) $row->last_active;
    }
  }
  $reply_rows = db_query('SELECT r.forum_id, COUNT(r.reply_id) AS replies FROM {entity_forum_reply} r INNER JOIN {entity_forum_topic} t ON t.topic_id = r.topic_id WHERE r.status = 1 AND t.listing = :listing GROUP BY r.forum_id', array(
    ':listing' => ENTITY_FORUM_LISTING_NORMAL,
  ));
  foreach ($reply_rows as $row) {
    if (isset($map[$row->forum_id])) {
      $map[$row->forum_id]['reply_count'] = (int) $row->replies;
    }
  }

  // Roll each forum's own tallies up into all of its ancestors, so a
  // parent's totals include its whole sub-tree. Walk parent_id links
  // with a visited guard, tolerating any accidental cycle in the data.
  foreach ($map as $forum_id => $own) {
    $ancestor = $own['parent_id'];
    $seen = array($forum_id => TRUE);
    while ($ancestor && isset($map[$ancestor]) && empty($seen[$ancestor])) {
      $map[$ancestor]['topic_count'] += $own['topic_count'];
      $map[$ancestor]['reply_count'] += $own['reply_count'];
      if ($own['last_active_time'] > $map[$ancestor]['last_active_time']) {
        $map[$ancestor]['last_active_time'] = $own['last_active_time'];
      }
      $seen[$ancestor] = TRUE;
      $ancestor = $map[$ancestor]['parent_id'];
    }
  }

  // Derive the bbPress-style "Posts" total (topics + replies) and drop
  // the internal parent_id helper from the returned rows.
  foreach ($map as $forum_id => &$row) {
    $row['post_count'] = $row['topic_count'] + $row['reply_count'];
    unset($row['parent_id']);
  }
  unset($row);

  cache_set('entity_forum_forum_counts', $map);
  $cache = $map;
  return $cache;
}

/**
 * Counts the items currently awaiting moderator attention.
 *
 * Three indexed lookups, run only when a moderator is viewing (the
 * moderation panels and queue are permission-gated), so no caching is
 * needed.
 *
 * @return array
 *   Array with 'topics' and 'replies' pending counts and 'reports'
 *   (unresolved content reports).
 */
function entity_forum_pending_counts() {
  return array(
    'topics' => (int) db_query('SELECT COUNT(topic_id) FROM {entity_forum_topic} WHERE pending = 1')->fetchField(),
    'replies' => (int) db_query('SELECT COUNT(reply_id) FROM {entity_forum_reply} WHERE pending = 1')->fetchField(),
    'reports' => (int) db_query('SELECT COUNT(report_id) FROM {entity_forum_report} WHERE resolved = 0')->fetchField(),
  );
}

/**
 * Clears the cached forum counts map.
 *
 * Called whenever forums, topics or replies change, so
 * entity_forum_forum_counts() recomputes on next read.
 */
function entity_forum_forum_counts_reset() {
  backdrop_static_reset('entity_forum_forum_counts');
  cache_clear_all('entity_forum_forum_counts', 'cache');
}

/**
 * Returns the forum_id => parent_id map for all forums.
 *
 * Statically cached; the source of the ancestor/descendant helpers and
 * the counts rollup.
 *
 * @return array
 *   Map of forum_id to (int) parent_id.
 */
function entity_forum_forum_parents() {
  $parents = &backdrop_static(__FUNCTION__);
  if (!isset($parents)) {
    $parents = array();
    foreach (db_query('SELECT forum_id, parent_id FROM {entity_forum_forum}') as $forum) {
      $parents[$forum->forum_id] = (int) $forum->parent_id;
    }
  }
  return $parents;
}

/**
 * Returns a forum's ancestor IDs, root-first (nearest parent last).
 *
 * Walks parent_id links with a visited guard so a corrupt cycle in the
 * data can never loop forever. Suitable for building breadcrumbs.
 *
 * @param int $forum_id
 *   The forum to find ancestors of.
 *
 * @return array
 *   Ancestor forum IDs ordered from the root down to the immediate
 *   parent (excludes the forum itself); empty for a top-level forum.
 */
function entity_forum_forum_ancestors($forum_id) {
  $parents = entity_forum_forum_parents();
  $chain = array();
  $seen = array((int) $forum_id => TRUE);
  $parent = isset($parents[$forum_id]) ? $parents[$forum_id] : 0;
  while ($parent && isset($parents[$parent]) && empty($seen[$parent])) {
    $chain[] = $parent;
    $seen[$parent] = TRUE;
    $parent = $parents[$parent];
  }
  return array_reverse($chain);
}

/**
 * Returns a forum's descendant IDs (children, grandchildren, ...).
 *
 * Used to keep a forum from being re-parented under its own sub-tree,
 * which would create a cycle.
 *
 * @param int $forum_id
 *   The forum to find descendants of.
 *
 * @return array
 *   Descendant forum IDs (excludes the forum itself).
 */
function entity_forum_forum_descendants($forum_id) {
  $parents = entity_forum_forum_parents();
  $descendants = array();
  $frontier = array((int) $forum_id);
  while ($frontier) {
    $current = array_pop($frontier);
    foreach ($parents as $child_id => $parent_id) {
      if ($parent_id === $current && !in_array($child_id, $descendants, TRUE) && $child_id != $forum_id) {
        $descendants[] = $child_id;
        $frontier[] = $child_id;
      }
    }
  }
  return $descendants;
}

/**
 * Renders an author name with date for forum posts.
 *
 * @param int $uid
 *   Author user ID (may be negative/dangling for deleted accounts).
 * @param int $timestamp
 *   Post creation time.
 * @param string $author_name
 *   The stored author_name snapshot, shown when the account is gone.
 *
 * @return string
 *   Sanitized "name — date" HTML snippet.
 */
function entity_forum_format_byline($uid, $timestamp, $author_name = '') {
  return t('!name — !date', array(
    '!name' => entity_forum_format_author($uid, $author_name),
    '!date' => format_date($timestamp, 'short'),
  ));
}

/**
 * Menu access callback: may the viewer see this account's Forum tab?
 *
 * Moderators are included so they can review a member's posts and set
 * the member's posting status from the same tab.
 *
 * @param object $account
 *   The account whose posts would be listed.
 *
 * @return bool
 *   TRUE for the account owner, user administrators and forum moderators.
 */
function entity_forum_user_posts_access($account) {
  return $GLOBALS['user']->uid == $account->uid
    || user_access('administer users')
    || entity_forum_user_is_moderator();
}

/**
 * Saves a member's forum posting name and refreshes post snapshots.
 *
 * Stores the handle in the account's data array (removed when empty, so
 * the account name applies again) and refreshes the author_name snapshots
 * on the member's existing posts so the new name applies everywhere,
 * including after a later account deletion.
 *
 * @param object $account
 *   The account to save the posting name for.
 * @param string $posting_name
 *   The new posting name; an empty string clears it.
 */
function entity_forum_posting_name_save($account, $posting_name) {
  $posting_name = trim($posting_name);

  $data = $account->data;
  if ($posting_name === '') {
    unset($data['entity_forum_posting_name']);
  }
  else {
    $data['entity_forum_posting_name'] = $posting_name;
  }
  db_update('users')
    ->fields(array('data' => serialize($data)))
    ->condition('uid', $account->uid)
    ->execute();
  entity_get_controller('user')->resetCache(array($account->uid));

  // Refresh the snapshots on existing posts.
  $fresh = user_load($account->uid);
  $display_name = entity_forum_user_display_name($fresh);
  foreach (array('entity_forum_forum', 'entity_forum_topic', 'entity_forum_reply') as $table) {
    db_update($table)
      ->fields(array('author_name' => $display_name))
      ->condition('author_uid', $account->uid)
      ->execute();
    entity_get_controller($table)->resetCache();
  }
}


/**
 * Implements hook_views_pre_render().
 *
 * For the admin replies view (which provides the Replies tab via its own
 * page display): attaches the admin stylesheet — so it follows the view
 * wherever it is shown, including a site builder's clone — and strips
 * HTML from the content column. The Views "Strip HTML tags" rewrite
 * option can't do the strip: the column is rewritten into a link and the
 * strip runs after the rewrite, so it would remove the link itself.
 */
function entity_forum_views_pre_render(&$view) {
  if ($view->name == 'forum_replies_admin') {
    backdrop_add_css(backdrop_get_path('module', 'entity_forum') . '/css/entity_forum_admin.css');
    foreach ($view->result as $row) {
      if (isset($row->entity_forum_reply_content)) {
        $row->entity_forum_reply_content = strip_tags($row->entity_forum_reply_content);
      }
    }
  }
}
