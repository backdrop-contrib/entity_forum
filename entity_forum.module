<?php

/**
 * @file
 * Entity Forum: a bbPress-style forum built on custom entities.
 *
 * Provides three entity types managed by EntityPlusController:
 * - entity_forum_forum: forum containers (nestable, public or private).
 * - entity_forum_topic: discussion threads within a forum.
 * - entity_forum_reply: replies to a topic (optionally threaded).
 *
 * Frontend pages live in entity_forum.pages.inc, admin UI in entity_forum.admin.inc,
 * entity classes in includes/entity_forum.entity.inc.
 */

/**
 * Topic listing modes: how a topic appears in forum topic lists.
 *
 * - normal: listed for everyone who can view the forum.
 * - admin_only: listed only for moderators (for review/moderation); the
 *   topic page itself is also restricted to moderators.
 * - unlisted: never listed, but the topic page stays viewable at its own
 *   URL — used for e.g. node-attached comment threads.
 */
define('ENTITY_FORUM_LISTING_NORMAL', 'normal');
define('ENTITY_FORUM_LISTING_ADMIN_ONLY', 'admin_only');
define('ENTITY_FORUM_LISTING_UNLISTED', 'unlisted');

/**
 * Returns the topic listing mode options for select elements.
 *
 * @return array
 *   Options keyed by listing machine name.
 */
function entity_forum_topic_listing_options() {
  return array(
    ENTITY_FORUM_LISTING_NORMAL => t('Shown in the forum topic list'),
    ENTITY_FORUM_LISTING_ADMIN_ONLY => t('Shown only to moderators (for moderation)'),
    ENTITY_FORUM_LISTING_UNLISTED => t('Not shown in the forum topic list'),
  );
}

/**
 * Member posting statuses: how a member's new posts are treated.
 *
 * - normal: posts appear immediately (the default; not stored).
 * - review: every new topic and reply is held for moderator approval
 *   before it becomes visible (pending flag + the existing hold
 *   machinery: admin_only listing for topics, unpublished for replies).
 * - suspended: the member cannot post at all.
 */
define('ENTITY_FORUM_POSTING_NORMAL', 'normal');
define('ENTITY_FORUM_POSTING_REVIEW', 'review');
define('ENTITY_FORUM_POSTING_SUSPENDED', 'suspended');

/**
 * Returns the member posting status options for select elements.
 *
 * @return array
 *   Options keyed by posting status machine name.
 */
function entity_forum_posting_status_options() {
  return array(
    ENTITY_FORUM_POSTING_NORMAL => t('Normal — posts appear immediately'),
    ENTITY_FORUM_POSTING_REVIEW => t('Review — posts are held until a moderator approves them'),
    ENTITY_FORUM_POSTING_SUSPENDED => t('Suspended — cannot post topics or replies'),
  );
}

/**
 * Returns a member's forum posting status.
 *
 * Stored in the account data array like the posting name; absent means
 * normal. Anonymous (and gone) accounts report normal — they are gated
 * by permissions, not posting status.
 *
 * @param object|int|null $account
 *   A user account or uid; defaults to the current user.
 *
 * @return string
 *   One of the ENTITY_FORUM_POSTING_* values.
 */
function entity_forum_user_posting_status($account = NULL) {
  if (!isset($account)) {
    $account = $GLOBALS['user'];
  }
  if (is_numeric($account)) {
    $account = $account > 0 ? user_load($account) : FALSE;
  }
  if ($account && !empty($account->data['entity_forum_posting_status'])) {
    $status = $account->data['entity_forum_posting_status'];
    if (in_array($status, array(ENTITY_FORUM_POSTING_REVIEW, ENTITY_FORUM_POSTING_SUSPENDED), TRUE)) {
      return $status;
    }
  }
  return ENTITY_FORUM_POSTING_NORMAL;
}

/**
 * Saves a member's forum posting status.
 *
 * 'normal' removes the entry from the account data array so unrestricted
 * members carry no marker at all.
 *
 * @param object $account
 *   The account the status applies to.
 * @param string $status
 *   One of the ENTITY_FORUM_POSTING_* values.
 */
function entity_forum_posting_status_save($account, $status) {
  $data = $account->data;
  if ($status === ENTITY_FORUM_POSTING_REVIEW || $status === ENTITY_FORUM_POSTING_SUSPENDED) {
    $data['entity_forum_posting_status'] = $status;
  }
  else {
    unset($data['entity_forum_posting_status']);
  }
  db_update('users')
    ->fields(array('data' => serialize($data)))
    ->condition('uid', $account->uid)
    ->execute();
  $account->data = $data;
  entity_get_controller('user')->resetCache(array($account->uid));
}

/**
 * Decides whether a new frontend post must be held for moderator review.
 *
 * The built-in rule holds posts by members with the 'review' posting
 * status. Other modules can add their own rules (AI moderation,
 * probation periods, ...) via hook_entity_forum_post_hold_alter() —
 * see entity_forum.api.php. Called by the frontend topic and reply form
 * submits before the entity is saved; the hold itself uses the existing
 * machinery (admin_only listing for topics, unpublished for replies)
 * plus the pending flag, with the reason recorded in pending_reason.
 *
 * @param object $entity
 *   The unsaved topic or reply, with content already set.
 * @param string $entity_type
 *   entity_forum_topic or entity_forum_reply.
 * @param object|null $account
 *   The posting account; defaults to the current user.
 *
 * @return array
 *   Array with:
 *   - hold: (bool) TRUE to hold the post for review.
 *   - reason: (string) short machine reason shown to moderators in the
 *     queue (max 64 chars stored), e.g. 'posting_status'.
 */
function entity_forum_post_hold($entity, $entity_type, $account = NULL) {
  if (!isset($account)) {
    $account = $GLOBALS['user'];
  }
  $hold = array(
    'hold' => entity_forum_user_posting_status($account) === ENTITY_FORUM_POSTING_REVIEW,
    'reason' => 'posting_status',
  );
  $context = array(
    'entity' => $entity,
    'entity_type' => $entity_type,
    'account' => $account,
  );
  backdrop_alter('entity_forum_post_hold', $hold, $context);
  return $hold;
}

/**
 * Returns the human label for a pending_reason value in the queue.
 *
 * @param string $reason
 *   The stored pending_reason.
 *
 * @return string
 *   Sanitized label.
 */
function entity_forum_pending_reason_label($reason) {
  if ($reason === 'posting_status') {
    return t('Member posting status');
  }
  return $reason === '' ? '' : check_plain($reason);
}

/**
 * Whether an account is a forum moderator.
 *
 * Moderators see moderation panels and held (admin_only) topics, work the
 * moderation queue, and set member posting statuses. The dedicated
 * 'moderate entity forum' permission grants it; the broader administer
 * permissions imply it.
 *
 * @param object|null $account
 *   The user to check; defaults to the current user.
 *
 * @return bool
 *   TRUE when the account may moderate.
 */
function entity_forum_user_is_moderator($account = NULL) {
  return user_access('moderate entity forum', $account)
    || user_access('administer entity forum topic', $account)
    || user_access('administer entity forum', $account);
}

