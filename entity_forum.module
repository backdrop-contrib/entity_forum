<?php

/**
 * @file
 * Entity Forum: a bbPress-style forum built on custom entities.
 *
 * Provides three entity types managed by EntityPlusController:
 * - entity_forum_forum: forum containers (nestable, public or private).
 * - entity_forum_topic: discussion threads within a forum.
 * - entity_forum_reply: replies to a topic (optionally threaded).
 *
 * Frontend pages live in entity_forum.pages.inc, admin UI in entity_forum.admin.inc,
 * entity classes in includes/entity_forum.entity.inc.
 */

/**
 * Implements hook_entity_info().
 */
function entity_forum_entity_info() {
  $info = array();

  $info['entity_forum_forum'] = array(
    'label' => t('Entity Forum'),
    'plural label' => t('Entity Forums'),
    'description' => t('A forum container holding discussion topics.'),
    'entity class' => 'EntityForumForum',
    'controller class' => 'EntityPlusController',
    'module' => 'entity_forum',
    'base table' => 'entity_forum_forum',
    'fieldable' => TRUE,
    'entity keys' => array(
      'id' => 'forum_id',
      'label' => 'title',
    ),
    'bundles' => array(
      'entity_forum_forum' => array(
        'label' => t('Entity Forum'),
        'admin' => array(
          'path' => 'admin/structure/entity-forum/forum',
          'access arguments' => array('administer entity forum'),
        ),
      ),
    ),
    'view modes' => array(
      'full' => array(
        'label' => t('Full'),
        'custom settings' => FALSE,
      ),
    ),
    'uri callback' => 'entity_forum_forum_uri',
    'access callback' => 'entity_forum_forum_access',
  );

  $info['entity_forum_topic'] = array(
    'label' => t('Entity Forum Topic'),
    'plural label' => t('Entity Forum Topics'),
    'description' => t('A discussion thread within a forum.'),
    'entity class' => 'EntityForumTopic',
    'controller class' => 'EntityPlusController',
    'module' => 'entity_forum',
    'base table' => 'entity_forum_topic',
    'fieldable' => TRUE,
    'entity keys' => array(
      'id' => 'topic_id',
      'label' => 'title',
    ),
    'bundles' => array(
      'entity_forum_topic' => array(
        'label' => t('Entity Forum Topic'),
        'admin' => array(
          'path' => 'admin/structure/entity-forum/topic',
          'access arguments' => array('administer entity forum'),
        ),
      ),
    ),
    'view modes' => array(
      'full' => array(
        'label' => t('Full'),
        'custom settings' => FALSE,
      ),
    ),
    'uri callback' => 'entity_forum_topic_uri',
    'access callback' => 'entity_forum_topic_access',
  );

  $info['entity_forum_reply'] = array(
    'label' => t('Entity Forum Reply'),
    'plural label' => t('Entity Forum Replies'),
    'description' => t('A reply to a forum topic.'),
    'entity class' => 'EntityForumReply',
    'controller class' => 'EntityPlusController',
    'module' => 'entity_forum',
    'base table' => 'entity_forum_reply',
    'fieldable' => TRUE,
    'entity keys' => array(
      'id' => 'reply_id',
    ),
    'bundles' => array(
      'entity_forum_reply' => array(
        'label' => t('Entity Forum Reply'),
        'admin' => array(
          'path' => 'admin/structure/entity-forum/reply',
          'access arguments' => array('administer entity forum'),
        ),
      ),
    ),
    'view modes' => array(
      'full' => array(
        'label' => t('Full'),
        'custom settings' => FALSE,
      ),
    ),
    'uri callback' => 'entity_forum_reply_uri',
